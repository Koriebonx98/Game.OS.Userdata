{
  "name": "digital-abyss-desktop",
  "productName": "Digital Abyss",
  "version": "1.0.0",
  "description": "Digital Abyss - a Game OS exclusive. Standalone PC app (signs in with your Game OS account).",
  "main": "main.js",
  "author": "Game OS",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.gameos.digitalabyss",
    "productName": "Digital Abyss",
    "files": ["main.js", "offline.html"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "artifactName": "DigitalAbyss-Setup.exe" }
  }
}
