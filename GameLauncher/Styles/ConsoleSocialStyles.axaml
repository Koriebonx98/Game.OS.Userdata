<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Console-style tiles, prompts and badges shared by Friends and Inbox. -->

    <Style Selector="TextBlock.con-title">
        <Setter Property="FontSize" Value="34"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="LetterSpacing" Value="3"/>
    </Style>

    <Style Selector="TextBlock.con-section">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#8b949e"/>
        <Setter Property="LetterSpacing" Value="2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.con-pill">
        <Setter Property="Background" Value="#161b22"/>
        <Setter Property="BorderBrush" Value="#30363d"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="10,3"/>
    </Style>

    <!-- Selectable tile: lights up and grows slightly when focused. -->
    <Style Selector="Border.con-tile">
        <Setter Property="Background" Value="#141a22"/>
        <Setter Property="BorderBrush" Value="#222a35"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="18,14"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="RenderTransformOrigin" Value="0%,50%"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.con-tile:pointerover">
        <Setter Property="Background" Value="#1a2230"/>
        <Setter Property="BorderBrush" Value="#30496b"/>
    </Style>
    <Style Selector="Border.con-tile.sel">
        <Setter Property="Background" Value="#16253d"/>
        <Setter Property="BorderBrush" Value="#58a6ff"/>
        <Setter Property="RenderTransform" Value="scale(1.015)"/>
        <Setter Property="BoxShadow" Value="0 0 22 0 #5558a6ff"/>
    </Style>

    <!-- Controller button glyphs -->
    <Style Selector="Border.con-btn">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.con-btn > TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#0d1117"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.con-btn.a"><Setter Property="Background" Value="#3fb950"/></Style>
    <Style Selector="Border.con-btn.b"><Setter Property="Background" Value="#f85149"/></Style>
    <Style Selector="Border.con-btn.x"><Setter Property="Background" Value="#58a6ff"/></Style>
    <Style Selector="Border.con-btn.y"><Setter Property="Background" Value="#e3b341"/></Style>
    <Style Selector="Border.con-btn.s"><Setter Property="Background" Value="#c9d1d9"/></Style>

    <!-- Action chip: glyph + label -->
    <Style Selector="Button.con-act">
        <Setter Property="Background" Value="#1c2430"/>
        <Setter Property="BorderBrush" Value="#2d3846"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="8,5,14,5"/>
        <Setter Property="Foreground" Value="#e6edf3"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.con-act:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#26384f"/>
        <Setter Property="BorderBrush" Value="#58a6ff"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.con-act /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="16"/>
    </Style>

    <Style Selector="Border.con-avatar">
        <Setter Property="Width" Value="54"/>
        <Setter Property="Height" Value="54"/>
        <Setter Property="CornerRadius" Value="27"/>
        <Setter Property="Background" Value="#1f6feb"/>
    </Style>

    <Style Selector="Border.con-dot">
        <Setter Property="Width" Value="9"/>
        <Setter Property="Height" Value="9"/>
        <Setter Property="Background" Value="#484f58"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.con-dot.online"><Setter Property="Background" Value="#3fb950"/></Style>
    <Style Selector="Border.con-dot.away"><Setter Property="Background" Value="#e8960c"/></Style>

    <!-- Bottom button-prompt bar -->
    <Style Selector="Border.con-bar">
        <Setter Property="Background" Value="#0a0e14"/>
        <Setter Property="BorderBrush" Value="#222a35"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="32,10"/>
    </Style>
    <Style Selector="TextBlock.con-bar-text">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#c9d1d9"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
</Styles>
