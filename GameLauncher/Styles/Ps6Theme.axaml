<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- PS6 (PlayStation 6 concept UI inspired: deep navy, frosted glass, soft glow) override theme
         Colour palette:
           Background     #070A14  (deep navy)
           Card surface   #171D33
           Sidebar        #0C1020
           Active accent  #8FA8FF  (periwinkle)
           Focus ring     #9BE7FF  (ice cyan glow)
           Primary text   #FFFFFF / #ECECEC
           Secondary text #B3B3B3 / #9E9E9E
    -->

    <!-- ── Dashboard layout visibility ── -->
    <Style Selector="Border.dashboard-ps6-layout">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <Style Selector="Border.dashboard-xb360-layout">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <Style Selector="Border.dashboard-wii-layout">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <Style Selector="StackPanel.dashboard-default-layout">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- ── Shell backgrounds ── -->
    <Style Selector="Window.main-window-shell">
        <Setter Property="Background" Value="#070A14"/>
    </Style>

    <Style Selector="Border.main-content-surface">
        <Setter Property="Background" Value="#070A14"/>
    </Style>

    <Style Selector="Border.detail-overlay-surface">
        <Setter Property="Background" Value="#070A14"/>
    </Style>

    <Style Selector="UserControl.dashboard-root">
        <Setter Property="Background" Value="#030319"/>
    </Style>

    <Style Selector="Border.dashboard-ps6-layout">
        <Setter Property="Background" Value="#030319"/>
    </Style>

    <!-- ── Top bar / friend strip ── -->
    <Style Selector="Border.friend-profile-topbar">
        <Setter Property="Background" Value="#0C1020"/>
        <Setter Property="BorderBrush" Value="#171D33"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style Selector="Border.sync-overlay-panel">
        <Setter Property="Background" Value="#121830"/>
        <Setter Property="BorderBrush" Value="#8FA8FF"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ── Navigation sidebar ── -->
    <Style Selector="Border.nav-sidebar">
        <Setter Property="Background" Value="#0C1020"/>
    </Style>

    <Style Selector="Border.nav-logo-area">
        <Setter Property="Background" Value="#2A3A9E"/>
        <Setter Property="BorderBrush" Value="#3D52D6"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style Selector="TextBlock.nav-logo-text">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style Selector="Button.nav-item">
        <Setter Property="Foreground" Value="#B3B3B3"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Margin" Value="8,2"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.nav-item /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style Selector="Button.nav-item:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#171D33"/>
    </Style>

    <Style Selector="Button.nav-item.active /template/ ContentPresenter">
        <Setter Property="Background" Value="#3D52D6"/>
    </Style>

    <Style Selector="Button.nav-item.active">
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <!-- ── Page text ── -->
    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="Foreground" Value="#ECECEC"/>
    </Style>

    <Style Selector="TextBlock.page-subtitle">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#9E9E9E"/>
    </Style>

    <Style Selector="TextBlock.section-header">
        <Setter Property="Foreground" Value="#ECECEC"/>
    </Style>

    <!-- ── Stat tiles ── -->
    <Style Selector="Border.stat-tile">
        <Setter Property="Background" Value="#121830"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="TextBlock.stat-number-achievements">
        <Setter Property="Foreground" Value="#9BE7FF"/>
    </Style>

    <Style Selector="TextBlock.stat-number-platforms">
        <Setter Property="Foreground" Value="#8FA8FF"/>
    </Style>

    <Style Selector="TextBlock.stat-number-playtime">
        <Setter Property="Foreground" Value="#B3B3B3"/>
    </Style>

    <!-- ── Hero / featured banner ── -->
    <Style Selector="Border.featured-hero-banner">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0E1745" Offset="0"/>
                    <GradientStop Color="#060A22" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Border.hero-feature-badge">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="#2A3A9E"/>
    </Style>

    <Style Selector="Border.hero-platform-badge">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="#0E1745"/>
        <Setter Property="BorderBrush" Value="#8FA8FF"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="TextBlock.hero-platform-badge-text">
        <Setter Property="Foreground" Value="#8FA8FF"/>
    </Style>

    <!-- ── Game platform pill ── -->
    <Style Selector="Border.game-platform-pill">
        <Setter Property="Background" Value="#2A3A9E"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <!-- ── Game cards ── -->
    <Style Selector="Border.game-card">
        <Setter Property="Background" Value="#171D33"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.game-card-btn /template/ ContentPresenter">
        <Setter Property="Background" Value="#171D33"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.game-card-btn">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.game-card-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#202845"/>
    </Style>

    <!-- PS6-specific game-card strip buttons (wider, no info panel below) -->
    <Style Selector="Button.ps6-game-card-btn">
        <Setter Property="Width" Value="170"/>
        <Setter Property="Margin" Value="8,0"/>
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="Button.ps6-game-card-btn:focus /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="#9BE7FF"/>
    </Style>

    <Style Selector="Button.ps6-game-card-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#202845"/>
    </Style>

    <!-- Store cards -->
    <Style Selector="Border.store-card">
        <Setter Property="Background" Value="#171D33"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ── Achievement cards ── -->
    <Style Selector="Border.achievement-card">
        <Setter Property="Background" Value="#121830"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Border.achievement-icon-card">
        <Setter Property="Background" Value="#2D2D00"/>
    </Style>

    <Style Selector="TextBlock.achievement-meta">
        <Setter Property="Foreground" Value="#9E9E9E"/>
    </Style>

    <Style Selector="TextBlock.achievement-divider">
        <Setter Property="Foreground" Value="#3A3A3A"/>
    </Style>

    <!-- ── Buttons ── -->
    <!-- Primary action — PS6 pill: dark translucent, rounded pill shape -->
    <Style Selector="Button.btn-primary">
        <Setter Property="Background" Value="#222224"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#2E2E32"/>
    </Style>

    <!-- PS6 primary action specific (full-width pill) -->
    <Style Selector="Button.ps6-action-primary">
        <Setter Property="CornerRadius" Value="23"/>
    </Style>

    <!-- PS6 "more" square button -->
    <Style Selector="Button.ps6-action-more">
        <Setter Property="Background" Value="#141A30"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#ECECEC"/>
    </Style>

    <!-- Secondary -->
    <Style Selector="Button.btn-secondary">
        <Setter Property="Foreground" Value="#B3B3B3"/>
        <Setter Property="BorderBrush" Value="#3A3A3A"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Button.btn-secondary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#171D33"/>
    </Style>

    <Style Selector="Button.btn-secondary.active /template/ ContentPresenter">
        <Setter Property="Background" Value="#3D52D6"/>
        <Setter Property="BorderBrush" Value="#9BE7FF"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="Button.btn-secondary.active">
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <!-- ── Form inputs ── -->
    <Style Selector="TextBox.form-input">
        <Setter Property="Background" Value="#121830"/>
        <Setter Property="BorderBrush" Value="#3A3A3A"/>
        <Setter Property="Foreground" Value="#ECECEC"/>
    </Style>

    <!-- ── Settings navigation ── -->
    <Style Selector="Button.settings-nav-item">
        <Setter Property="Foreground" Value="#B3B3B3"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Margin" Value="8,2"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.settings-nav-item /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style Selector="Button.settings-nav-item:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#171D33"/>
    </Style>

    <Style Selector="Button.settings-nav-item.active /template/ ContentPresenter">
        <Setter Property="Background" Value="#3D52D6"/>
    </Style>

    <Style Selector="Button.settings-nav-item.active">
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <!-- ── Empty state ── -->
    <Style Selector="Border.empty-state-card">
        <Setter Property="Background" Value="#121830"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="TextBlock.empty-state-title">
        <Setter Property="Foreground" Value="#9E9E9E"/>
    </Style>

    <Style Selector="TextBlock.empty-state-subtitle">
        <Setter Property="Foreground" Value="#5A5A5A"/>
    </Style>

    <Style Selector="TextBlock.game-playtime-meta">
        <Setter Property="Foreground" Value="#B3B3B3"/>
    </Style>

    <!-- ── PS6 Dashboard specific classes ── -->

    <!-- "Games" heading -->
    <Style Selector="TextBlock.ps6-header-title">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <!-- " Media" softer heading -->
    <Style Selector="TextBlock.ps6-header-media">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="#B3B3B3"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="8,0,0,3"/>
    </Style>

    <!-- Game-strip card title -->
    <Style Selector="TextBlock.ps6-card-title">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#ECECEC"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxLines" Value="2"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <!-- Achievements panel backdrop -->
    <Style Selector="Border.ps6-achievements-panel">
        <Setter Property="Background" Value="#CC121830"/>
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="BorderBrush" Value="#262F52"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Bottom status tiles -->
    <Style Selector="Border.ps6-status-tile">
        <Setter Property="Background" Value="#AA171D33"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="TextBlock.ps6-status-value">
        <Setter Property="Foreground" Value="#D1D1D1"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="TextBlock.ps6-status-label">
        <Setter Property="Foreground" Value="#9E9E9E"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- ── Quick Menu hub buttons ── -->
    <Style Selector="Button.qm-hub-btn">
        <Setter Property="BorderThickness" Value="0,0,0,3"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="Button.qm-hub-btn.active /template/ ContentPresenter">
        <Setter Property="Background" Value="#44FFFFFF"/>
    </Style>

    <Style Selector="Button.qm-hub-btn.active">
        <Setter Property="BorderBrush" Value="White"/>
        <Setter Property="BorderThickness" Value="0,0,0,3"/>
    </Style>

    <!-- ── PS6 game card focused state ── -->
    <Style Selector="Button.ps6-game-card-btn.focused /template/ ContentPresenter">
        <Setter Property="Background" Value="#33FFFFFF"/>
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="BoxShadow" Value="0 0 32 2 #668FA8FF"/>
    </Style>

    <Style Selector="Button.ps6-game-card-btn.focused">
        <Setter Property="RenderTransform" Value="scale(1.06)"/>
        <Setter Property="BorderBrush" Value="#9BE7FF"/>
        <Setter Property="BorderThickness" Value="3"/>
    </Style>

    <Style Selector="TextBlock.ps6-header-title">
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="Foreground" Value="#F4F3FF"/>
    </Style>
    <Style Selector="TextBlock.ps6-header-media">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="#D6D4EF"/>
    </Style>
    <Style Selector="Button.ps6-header-icon">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Border.ps6-backdrop">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                    <GradientStop Color="#030319" Offset="0"/>
                    <GradientStop Color="#0B0B28" Offset="0.55"/>
                    <GradientStop Color="#17143D" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.ps6-header-icon.focused">
        <Setter Property="Foreground" Value="#9BE7FF"/>
        <Setter Property="RenderTransform" Value="scale(1.25)"/>
    </Style>
    <Style Selector="Button.ps6-shelf-card">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.ps6-shelf-card:pointerover Border">
        <Setter Property="BoxShadow" Value="0 0 14 2 #CC9BE7FF"/>
    </Style>
    <Style Selector="Button.ps6-carousel-card">
        <Setter Property="Width" Value="190"/>
        <Setter Property="Height" Value="250"/>
        <Setter Property="Margin" Value="10,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.ps6-carousel-cover">
        <Setter Property="Width" Value="190"/>
        <Setter Property="Height" Value="250"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="3"/>
    </Style>
    <Style Selector="Border.ps6-carousel-cover /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Border.ps6-store-cover">
        <Setter Property="Background" Value="#0B0B28"/>
        <Setter Property="BorderBrush" Value="#65658E"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.ps6-carousel-card.focused">
        <Setter Property="RenderTransform" Value="scale(1.22)"/>
        <Setter Property="ZIndex" Value="3"/>
    </Style>
    <Style Selector="Button.ps6-carousel-card.focused Border.ps6-carousel-cover">
        <Setter Property="BorderBrush" Value="#FFFFFF"/>
        <Setter Property="BoxShadow" Value="0 0 26 5 #D0FFFFFF"/>
    </Style>
    <Style Selector="TextBlock.ps6-focused-title">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style Selector="Border.ps6-platform-badge">
        <Setter Property="Background" Value="#332E3164"/>
        <Setter Property="BorderBrush" Value="#D8D6FF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="8,3"/>
    </Style>
    <Style Selector="TextBlock.ps6-dock-label">
        <Setter Property="Foreground" Value="#D7D4F5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="16,0,0,6"/>
    </Style>
    <Style Selector="Border.ps6-dock">
        <Setter Property="Background" Value="#D80B0E22"/>
        <Setter Property="BorderBrush" Value="#556B72C8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="28"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="BoxShadow" Value="0 8 36 0 #99000000, 0 0 28 2 #445D6BFF"/>
    </Style>
    <Style Selector="Button.ps6-dock-button">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="#B9BCE6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.ps6-dock-button:pointerover">
        <Setter Property="Background" Value="#2B2F57"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.ps6-dock-button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#2B2F57"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.ps6-dock-button.active /template/ ContentPresenter">
        <Setter Property="Background" Value="#4350B8"/>
        <Setter Property="BorderBrush" Value="#9BE7FF"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.ps6-dock-button.active">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Background" Value="#4350B8"/>
        <Setter Property="BorderBrush" Value="#9BE7FF"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

</Styles>
