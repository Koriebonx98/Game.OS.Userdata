<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             x:Class="GameLauncher.Views.QuickMenuLib.SwitchQuickMenu"
             x:DataType="vm:QuickMenuViewModel">

    <UserControl.Styles>
        <Style Selector="Button.swg-icon">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.swg-icon /template/ ContentPresenter">
            <Setter Property="Background" Value="#3a3d45"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="32"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="4"/>
        </Style>
        <Style Selector="Button.swg-icon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4b4f5a"/>
        </Style>
        <Style Selector="Button.swg-icon.active /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="#00c3e3"/>
            <Setter Property="Background" Value="#4b4f5a"/>
        </Style>

        <Style Selector="Button.swg-row">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.swg-row /template/ ContentPresenter">
            <Setter Property="Background" Value="#2b2e36"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3"/>
        </Style>
        <Style Selector="Button.swg-row:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3a3d45"/>
        </Style>
        <Style Selector="Button.swg-row.cursor /template/ ContentPresenter">
            <Setter Property="Background" Value="#3a3d45"/>
            <Setter Property="BorderBrush" Value="#00c3e3"/>
        </Style>
        <Style Selector="Button.swg-row.info /template/ ContentPresenter">
            <Setter Property="Background" Value="#22252c"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto" IsVisible="{Binding UsesSwitchGuideLayout}">
        <Border Grid.Row="0" Width="680" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                Margin="24" Padding="22" CornerRadius="16" Background="#F01a1d24"
                BorderBrush="#e60012" BorderThickness="2">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Spacing="2" Margin="0,0,0,14">
                    <TextBlock Text="Quick Guide" FontSize="12" Foreground="#e60012" FontWeight="Bold"/>
                    <TextBlock Text="{Binding MenuTitle}" FontSize="26" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="{Binding MenuSubtitle}" FontSize="13" Foreground="#aaaaaa"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                <Border IsVisible="{Binding ShowMediaBar}" Background="#33000000" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding MediaStatusLabel}" Foreground="#c7d5e0" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button Classes="swg-icon" Width="44" Height="36" Command="{Binding MediaPreviousCommand}">⏮</Button>
                      <Button Classes="swg-icon" Width="44" Height="36" Command="{Binding MediaPlayPauseCommand}">⏯</Button>
                      <Button Classes="swg-icon" Width="44" Height="36" Command="{Binding MediaNextCommand}">⏭</Button>
                      <Button Classes="swg-icon" Width="44" Height="36" Command="{Binding MediaVolumeDownCommand}">🔉</Button>
                      <Button Classes="swg-icon" Width="44" Height="36" Command="{Binding MediaVolumeUpCommand}">🔊</Button>
                      <TextBlock Text="{Binding MediaVolumeLabel}" Foreground="White" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <StackPanel IsVisible="{Binding IsMediaPage}" Spacing="10">
                    <TextBlock Text="{Binding MediaStatusLabel}" Foreground="#aaaaaa" FontSize="13" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding MediaVolumeLabel}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding HubActions}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:QuickMenuHubActionVm">
                            <Button Classes="swg-row" Classes.cursor="{Binding IsCursor}" Width="86" Height="72" Margin="0,0,8,8"
                                    HorizontalContentAlignment="Center" Command="{Binding ActivateCommand}">
                                <StackPanel HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Glyph}" FontSize="22" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding HubActions}" IsVisible="{Binding !IsMediaPage}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:QuickMenuHubActionVm">
                                <Button Classes="swg-row" Classes.cursor="{Binding IsCursor}"
                                        Classes.info="{Binding !IsActionable}"
                                        IsHitTestVisible="{Binding IsActionable}"
                                        Command="{Binding ActivateCommand}">
                                    <Grid ColumnDefinitions="44,*">
                                        <TextBlock Text="{Binding Glyph}" FontSize="22" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Foreground="White"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#aaaaaa"
                                                       TextTrimming="CharacterEllipsis" IsVisible="{Binding HasSubtitle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,0,0,28" Spacing="12" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <Button Classes="swg-icon" Classes.active="{Binding IsHomePage}" Command="{Binding SelectHomeCommand}">🏠</Button>
                <Button Classes="swg-icon" Classes.active="{Binding IsSwitcherPage}" Command="{Binding SelectSwitcherCommand}">🗂</Button>
                <Button Classes="swg-icon" Classes.active="{Binding IsRecentGamesPage}" Command="{Binding SelectRecentGamesCommand}">🎮</Button>
                <Button Classes="swg-icon" Classes.active="{Binding IsNotificationsPage}" Command="{Binding SelectNotificationsCommand}">🔔</Button>
                <Button Classes="swg-icon" Classes.active="{Binding IsDownloadsPage}" Command="{Binding SelectDownloadsCommand}">⬇</Button>
                <Button Classes="swg-icon" Classes.active="{Binding IsFriendsPage}" Command="{Binding SelectFriendsCommand}">👥</Button>
                <Button Classes="swg-icon" Classes.active="{Binding IsInboxPage}" Command="{Binding SelectInboxCommand}">📬</Button>
                <Button Classes="swg-icon" Classes.active="{Binding IsAchievementsPage}" Command="{Binding OpenAchievementsCommand}">🏆</Button>
                <Button Classes="swg-icon" Classes.active="{Binding IsMediaPage}" Command="{Binding SelectMediaCommand}">🎵</Button>
                <Button Classes="swg-icon" Classes.active="{Binding IsGuidesPage}" Command="{Binding SelectGuidesCommand}">📖</Button>
                <Button Classes="swg-icon" Classes.active="{Binding IsBrowserPage}" Command="{Binding SelectBrowserCommand}">🌐</Button>
                <Button Classes="swg-icon" Classes.active="{Binding IsPowerPage}" Command="{Binding SelectPowerCommand}">⏻</Button>
            </StackPanel>
            <TextBlock HorizontalAlignment="Center" Foreground="#cccccc" FontSize="14"
                       Text="◀ ▶ Page      ▲ ▼ Select      Ⓐ OK      Ⓑ Back"/>
        </StackPanel>
    </Grid>
</UserControl>
