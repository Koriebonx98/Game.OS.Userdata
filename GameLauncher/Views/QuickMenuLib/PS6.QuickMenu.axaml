<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             x:Class="GameLauncher.Views.QuickMenuLib.Ps6QuickMenu"
             x:DataType="vm:QuickMenuViewModel">

    <UserControl.Styles>
        <Style Selector="Border.ps6-dock">
            <Setter Property="Background" Value="#EC060608"/>
            <Setter Property="BorderBrush" Value="#8A77779C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BoxShadow" Value="0 0 22 2 #666A6CBA"/>
        </Style>
        <Style Selector="Button.ps6-guide-button">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Foreground" Value="#F3F2FF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="Button.ps6-guide-button.active">
            <Setter Property="Background" Value="#373652"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.ps6-guide-action">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Background" Value="#AA17172B"/>
            <Setter Property="Foreground" Value="#F4F3FF"/>
            <Setter Property="BorderBrush" Value="#66657D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
        <Style Selector="Button.ps6-guide-action.cursor">
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </UserControl.Styles>

    <Grid IsVisible="{Binding UsesPs6GuideLayout}">
        <Grid RowDefinitions="*,Auto" Margin="36,24,36,32">
            <StackPanel Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Margin="0,0,0,22" Spacing="8">
                <TextBlock Text="{Binding MenuTitle}" Foreground="#FFFFFF" FontSize="18"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding CurrentSessionLabel}" Foreground="#D7D4F5" FontSize="13"
                           HorizontalAlignment="Center"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              MaxWidth="1100">
                    <ItemsControl ItemsSource="{Binding HubActions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:QuickMenuHubActionVm">
                                <Button Classes="ps6-guide-action" Classes.cursor="{Binding IsCursor}"
                                        IsHitTestVisible="{Binding IsActionable}"
                                        Command="{Binding ActivateCommand}">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="210"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="#C5C2E8"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding HasSubtitle}" MaxWidth="210"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                <TextBlock Text="L1 / R1  Change section     ▲ / ▼  Choose action     ✕  Select     ○  Back"
                           Foreground="#B8B5D9" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <Border Classes="ps6-dock">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="ps6-guide-button" Classes.active="{Binding IsHomePage}" Command="{Binding SelectHomeCommand}" ToolTip.Tip="Home">⌂</Button>
                        <Button Classes="ps6-guide-button" Classes.active="{Binding IsSwitcherPage}" Command="{Binding SelectSwitcherCommand}" ToolTip.Tip="Switcher">▣</Button>
                        <Button Classes="ps6-guide-button" Classes.active="{Binding IsNotificationsPage}" Command="{Binding SelectNotificationsCommand}" ToolTip.Tip="Notifications">♢</Button>
                        <Button Classes="ps6-guide-button" Classes.active="{Binding IsFriendsPage}" Command="{Binding SelectFriendsCommand}" ToolTip.Tip="Friends">♟</Button>
                        <Button Classes="ps6-guide-button" Classes.active="{Binding IsMediaPage}" Command="{Binding SelectMediaCommand}" ToolTip.Tip="Music">♫</Button>
                        <Button Classes="ps6-guide-button" Classes.active="{Binding IsRecentGamesPage}" Command="{Binding SelectRecentGamesCommand}" ToolTip.Tip="Recent games">▤</Button>
                        <Button Classes="ps6-guide-button" Classes.active="{Binding IsDownloadsPage}" Command="{Binding SelectDownloadsCommand}" ToolTip.Tip="Downloads">⇩</Button>
                        <Button Classes="ps6-guide-button" Classes.active="{Binding IsGuidesPage}" Command="{Binding SelectGuidesCommand}" ToolTip.Tip="Guides">⌖</Button>
                        <Button Classes="ps6-guide-button" Classes.active="{Binding IsAchievementsPage}" Command="{Binding OpenAchievementsCommand}" ToolTip.Tip="Achievements">◇</Button>
                        <Button Classes="ps6-guide-button" Classes.active="{Binding IsInboxPage}" Command="{Binding SelectInboxCommand}" ToolTip.Tip="Inbox">✉</Button>
                        <Button Classes="ps6-guide-button" Classes.active="{Binding IsSettingsPage}" Command="{Binding OpenSettingsPageCommand}" ToolTip.Tip="Settings">⚙</Button>
                        <Button Classes="ps6-guide-button" Classes.active="{Binding IsPowerPage}" Command="{Binding SelectPowerCommand}" ToolTip.Tip="Power">⏻</Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
