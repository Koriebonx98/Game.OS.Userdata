<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             xmlns:models="using:GameLauncher.Models"
             xmlns:views="using:GameLauncher.Views"
             x:Class="GameLauncher.Views.QuickMenuLib.GameOsQuickMenu"
             x:DataType="vm:QuickMenuViewModel">

        <UserControl.Styles>
            <Style Selector="Button.qm-gameos-friend.cursor /template/ ContentPresenter">
                <Setter Property="BorderBrush" Value="#58a6ff"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Style>
        </UserControl.Styles>

        <!-- GameOS quick panel (replaces PS5 hub bar for GameOS theme) -->
        <Border Classes="qm-gameos-panel"
                IsVisible="{Binding IsGameOsTheme}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,24,24,0"
                Width="290">
            <StackPanel Spacing="10">
                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Quick Menu" FontWeight="Bold" FontSize="15" Foreground="White"/>
                        <TextBlock Text="{Binding CurrentSessionLabel}" FontSize="11" Foreground="#8b949e"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="btn-secondary" Command="{Binding DismissCommand}"
                            Width="32" Height="32" Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">✕</Button>
                </Grid>
                <Rectangle Height="1" Fill="#30363d"/>
                <!-- Navigation items -->
                <ItemsControl ItemsSource="{Binding SwitcherItems}" IsVisible="{Binding !IsFriendsPage}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:QuickMenuSwitcherItemVm">
                            <Button Classes="btn-secondary"
                                    Classes.active="{Binding IsActive}"
                                    Command="{Binding $parent[UserControl].DataContext.OpenPageFromSwitcherCommand}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Margin="0,1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   Foreground="#e6edf3" FontSize="13"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="#8b949e" FontSize="10"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="✓"
                                               IsVisible="{Binding IsActive}"
                                               Foreground="#58a6ff" VerticalAlignment="Center"
                                               FontWeight="Bold" Margin="8,0,0,0"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Rectangle Height="1" Fill="#30363d"/>
                <Button Classes="btn-secondary" Command="{Binding AddFriendCommand}"
                        IsVisible="{Binding !IsFriendsPage}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <TextBlock Text="➕  Add Friend" FontWeight="SemiBold" Foreground="#e6edf3" FontSize="13"/>
                </Button>
                <Button Classes="btn-secondary" Command="{Binding SelectFriendsCommand}"
                        IsVisible="{Binding !IsFriendsPage}">🎮 Invite Friends</Button>
                <Button Classes="btn-secondary" Command="{Binding SelectHomeCommand}"
                        IsVisible="{Binding IsFriendsPage}">← Back</Button>
                <TextBlock Text="{Binding InviteStatusMessage}"
                           Foreground="#8b949e" FontSize="11" TextWrapping="Wrap"/>
                <ScrollViewer IsVisible="{Binding IsFriendsPage}" MaxHeight="350" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding HubActions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:QuickMenuHubActionVm">
                                <Button Classes="btn-secondary qm-gameos-friend" Classes.cursor="{Binding IsCursor}"
                                        views:BringIntoViewBehavior.Active="{Binding IsCursor}"
                                        IsHitTestVisible="{Binding IsActionable}" Command="{Binding ActivateCommand}"
                                        HorizontalAlignment="Stretch" Margin="0,2">
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Rectangle Height="1" Fill="#30363d"/>
                <!-- Exit game shortcut when playing -->
                <Button Classes="btn-primary"
                        IsVisible="{Binding IsPlayingGame}"
                        Command="{Binding ExitGameCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⏹" FontSize="13"/>
                        <TextBlock Text="Exit Game" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
</UserControl>
