<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             xmlns:models="using:GameLauncher.Models"
             xmlns:views="using:GameLauncher.Views"
             x:Class="GameLauncher.Views.QuickMenuLib.WiiQuickMenu"
             x:DataType="vm:QuickMenuViewModel">

        <Border Classes="qm-wii-shell"
                IsVisible="{Binding IsWiiTheme}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="24,0,24,24"
                Width="980">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="Wii Quick Menu" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding CurrentSessionLabel}" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentGameTitle}" FontSize="11" HorizontalAlignment="Center"
                                   IsVisible="{Binding IsPlayingGame}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="qm-wii-bubble" Command="{Binding DismissCommand}" Width="86">Close</Button>
                </Grid>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding HubActions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:QuickMenuHubActionVm">
                            <Button Classes="qm-wii-bubble" Classes.cursor="{Binding IsCursor}" Margin="5,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Focusable="False" Command="{Binding ActivateCommand}" Content="{Binding Title}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
</UserControl>
