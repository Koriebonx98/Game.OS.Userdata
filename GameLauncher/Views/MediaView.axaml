<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             xmlns:vlc="using:LibVLCSharp.Avalonia"
             xmlns:views="using:GameLauncher.Views"
             xmlns:lib="using:GameLauncher.Views.MediaLib"
             x:Class="GameLauncher.Views.MediaView"
             x:DataType="vm:MediaViewModel">

    <Panel>
        <!--
            Media page. The layouts live in separate files chosen by Settings -> Design:
              Views/MediaLib/Default.MoviesTv.axaml  ("Default")   Views/MediaLib/Cinema.MoviesTv.axaml ("Cinema")
              Views/MediaLib/Default.Music.axaml     ("Default")   Views/MediaLib/Spotify.Music.axaml    ("Spotify")
        -->
        <Panel IsVisible="{Binding !IsVlcFullView}">
            <Panel IsVisible="{Binding IsVideoSection}">
                <lib:DefaultMoviesTv IsVisible="{Binding IsDefaultMoviesTv}"/>
                <lib:CinemaMoviesTv IsVisible="{Binding IsCinemaMoviesTv}"/>
            </Panel>
            <Panel IsVisible="{Binding IsMusicSelected}">
                <lib:DefaultMusic IsVisible="{Binding IsDefaultMusic}"/>
                <lib:SpotifyMusic IsVisible="{Binding IsSpotifyMusic}"/>
            </Panel>
        </Panel>

        <!-- VLC player overlay (shown when IsVlcPlayerOpen) -->
        <Border Background="#0d1117"
                IsVisible="{Binding IsVlcPlayerOpen}"
                HorizontalAlignment="{Binding PlayerHAlign}" VerticalAlignment="{Binding PlayerVAlign}"
                Width="{Binding PlayerWidth}" Height="{Binding PlayerHeight}" Margin="{Binding PlayerMargin}"
                ZIndex="50" PointerMoved="OnPlayerPointerMoved">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Top bar -->
                <Border Grid.Row="0" Background="#161b22" Padding="16,10" IsVisible="False">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0"
                                Classes="btn-secondary"
                                Padding="10,6"
                                Command="{Binding CloseVlcPlayerCommand}">
                            ✕  Close
                        </Button>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding VlcMediaPath}"
                                   FontSize="13"
                                   Foreground="#c9d1d9"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2"
                                   Text="🎬 VLC Player"
                                   FontSize="12"
                                   Foreground="#8b949e"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Video surface -->
                <vlc:VideoView Grid.Row="1"
                               x:Name="VlcOverlayVideoView"/>

                <!-- B on the player: picture-in-picture / stop / keep watching -->
                <Border Grid.Row="2" Background="#161b22" Padding="24,14" ZIndex="5" IsVisible="{Binding IsPipPromptOpen}">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <TextBlock Text="Leave the video?" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <Button Classes="btn-primary media-nav" Classes.focused="{Binding IsPipChoice0}" Content="🗗  Picture-in-picture"
                                    Command="{Binding EnterPipCommand}"/>
                            <Button Classes="btn-secondary media-nav" Classes.focused="{Binding IsPipChoice1}" Content="{Binding FullscreenToggleLabel}"
                                    Command="{Binding ToggleFullscreenCommand}"/>
                            <Button Classes="btn-secondary media-nav" Classes.focused="{Binding IsPipChoice2}" Content="⏹  Stop"
                                    Command="{Binding CloseVlcPlayerCommand}"/>
                            <Button Classes="btn-secondary media-nav" Classes.focused="{Binding IsPipChoice3}" Content="Keep watching"
                                    Command="{Binding DismissPipPromptCommand}"/>
                        </StackPanel>
                        <TextBlock Text="◀ ▶ choose · A select · B cancel" FontSize="11" Foreground="#8b949e" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Transport: seek bar + play / pause / skip (A / X = pause, ◀ ▶ = skip, LT / RT = rewind / fast-forward, ▲ ▼ = ±1 min, B = close) -->
                <Border Grid.Row="2" Background="#161b22" Padding="24,10" IsVisible="{Binding ControlsVisible}">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <TextBlock Text="{Binding VideoPositionLabel}" FontSize="12" Foreground="#c9d1d9" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="Transparent" Padding="0,8" Cursor="Hand" Tag="video"
                                    PointerPressed="OnSeekPressed" PointerMoved="OnSeekMoved" PointerReleased="OnSeekReleased">
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding VideoProgressPercent}" Height="10"
                                             IsHitTestVisible="False"/>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding VideoDurationLabel}" FontSize="12" Foreground="#c9d1d9" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                            <Button Classes="btn-secondary media-nav" Classes.focused="{Binding IsTransportFocus0}" Command="{Binding VideoSeekBackCommand}" Content="⏪"/>
                            <Button Classes="btn-primary media-nav" Classes.focused="{Binding IsTransportFocus1}" MinWidth="64" HorizontalContentAlignment="Center"
                                    Command="{Binding ToggleVideoPauseCommand}" Content="{Binding VideoPlayPauseGlyph}"/>
                            <Button Classes="btn-secondary media-nav" Classes.focused="{Binding IsTransportFocus2}" Command="{Binding VideoSeekForwardCommand}" Content="⏩"/>
                            <Button Classes="btn-secondary media-nav" Classes.focused="{Binding IsTransportFocus3}" Command="{Binding ToggleFullscreenCommand}" Content="{Binding FullscreenToggleLabel}"/>
                            <Button Classes="btn-secondary media-nav" Classes.focused="{Binding IsTransportFocus4}" Command="{Binding EnterPipCommand}" Content="🗗  PiP"/>
                            <Button Classes="btn-secondary media-nav" Classes.focused="{Binding IsTransportFocus5}" Command="{Binding CloseVlcPlayerCommand}" Content="✕  Close"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Picture-in-picture controls (below the video: the native video surface always draws on top) -->
                <Border Grid.Row="2" Background="#161b22" Padding="8,4" IsVisible="{Binding IsPip}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <Button Classes="btn-secondary" Padding="10,4" Command="{Binding ToggleVideoPauseCommand}" Content="{Binding VideoPlayPauseGlyph}"/>
                        <Button Classes="btn-secondary" Padding="10,4" Command="{Binding ExitPipCommand}" Content="⤢  Expand"/>
                        <Button Classes="btn-secondary" Padding="10,4" Command="{Binding CloseVlcPlayerCommand}" Content="✕  Close"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- Movie / TV show info page -->
        <Border Background="#f20d1117" IsVisible="{Binding IsDetailOpen}" ZIndex="40" Padding="56,36">
            <Grid ColumnDefinitions="300,*" ColumnSpacing="44">
                <Border VerticalAlignment="Top" CornerRadius="12" ClipToBounds="True" BorderBrush="#30363d" BorderThickness="1"
                        BoxShadow="0 12 40 0 #99000000" Height="450">
                    <views:CoverImage FallbackText="{Binding SelectedItem.DisplayTitle}"
                                      FallbackGradient="{Binding SelectedItem.Gradient}"
                                      LocalCachePath="{Binding SelectedItem.CoverPath}"
                                      LetterFontSize="120" ImageCornerRadius="12" Height="450"/>
                </Border>
                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="12">
                    <TextBlock Text="{Binding DetailKindLabel}" FontSize="12" Foreground="#58a6ff" FontWeight="Bold" LetterSpacing="2"/>
                    <TextBlock Grid.Row="1" Text="{Binding SelectedItem.DisplayTitle}" FontSize="40" FontWeight="Black" TextWrapping="Wrap"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="14">
                        <Border Background="#1f6f3a" CornerRadius="6" Padding="10,4" IsVisible="{Binding SelectedItem.HasScore}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedItem.ScoreLabel}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                        </Border>
                        <TextBlock Text="{Binding SelectedItem.FactsLine}" FontSize="14" Foreground="#c9d1d9" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ItemsControl Grid.Row="3" ItemsSource="{Binding SelectedItem.GenreList}" IsVisible="{Binding SelectedItem.HasGenres}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Background="#21262d" BorderBrush="#30363d" BorderThickness="1" CornerRadius="14" Padding="12,4" Margin="0,0,8,6">
                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="#c9d1d9"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="4" Spacing="10">
                        <TextBlock Text="{Binding SelectedItem.Overview}" FontSize="15" LineHeight="22" Foreground="#c9d1d9" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left"
                                   MaxLines="6" TextTrimming="CharacterEllipsis" IsVisible="{Binding SelectedItem.HasOverview}"/>
                        <TextBlock Text="Looking up info…" FontSize="13" Foreground="#8b949e" IsVisible="{Binding !SelectedItem.HasOverview}"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Your rating" Foreground="#8b949e" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Classes="btn-secondary" Padding="8,2" Command="{Binding RateItemCommand}" CommandParameter="1" Content="★"/>
                            <Button Classes="btn-secondary" Padding="8,2" Command="{Binding RateItemCommand}" CommandParameter="2" Content="★★"/>
                            <Button Classes="btn-secondary" Padding="8,2" Command="{Binding RateItemCommand}" CommandParameter="3" Content="★★★"/>
                            <Button Classes="btn-secondary" Padding="8,2" Command="{Binding RateItemCommand}" CommandParameter="4" Content="★★★★"/>
                            <Button Classes="btn-secondary" Padding="8,2" Command="{Binding RateItemCommand}" CommandParameter="5" Content="★★★★★"/>
                            <TextBlock Text="{Binding SelectedItem.RatingStars}" Foreground="#f5c518" FontSize="16" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="#8b949e">
                            <Run Text="{Binding SelectedItem.PlayCountLabel}"/><Run Text="  ·  "/><Run Text="{Binding SelectedItem.LastPlayedLabel}"/><Run Text="  ·  "/><Run Text="{Binding SelectedItem.WatchTimeLabel}"/><Run Text="  ·  "/><Run Text="{Binding DetailAddedLabel}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="10" Margin="0,6,0,6">
                        <Button Classes="btn-primary media-nav" Classes.focused="{Binding IsDetailPlayFocused}" Padding="28,12" FontSize="15" FontWeight="Bold" Command="{Binding PlayDetailCommand}">▶  Play</Button>
                        <Button Classes="btn-secondary media-nav" Classes.focused="{Binding IsDetailListFocused}" Padding="18,10" Command="{Binding ToggleFavouriteCommand}" CommandParameter="{Binding SelectedItem}">♥  My List</Button>
                        <Button Classes="btn-secondary media-nav" Classes.focused="{Binding IsDetailWatchedFocused}" Padding="18,10" Command="{Binding ToggleWatchedCommand}" CommandParameter="{Binding SelectedItem}">✓  Watched</Button>
                        <Button Classes="btn-secondary media-nav" Classes.focused="{Binding IsDetailInfoFocused}" Padding="18,10" Command="{Binding RefreshOnlineInfoCommand}">⟳  Info</Button>
                        <Button Classes="btn-secondary media-nav" Classes.focused="{Binding IsDetailBackFocused}" Padding="18,10" Command="{Binding CloseDetailCommand}">‹  Back</Button>
                    </StackPanel>
                    <StackPanel Grid.Row="6" Spacing="8" IsVisible="{Binding HasDetailRelated}">
                        <TextBlock Text="{Binding DetailRelatedTitle}" Classes="section-header"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DetailRelated}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Classes="btn-secondary media-nav" Classes.focused="{Binding IsFocused}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Margin="0,0,0,4" Command="{Binding $parent[UserControl].DataContext.SelectMediaItemCommand}"
                                                CommandParameter="{Binding}" Content="{Binding ListTitle}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                    <TextBlock Grid.Row="7" Text="◀ ▶ ▲ ▼ move  ·  A select  ·  X play  ·  LB / RB rate  ·  Start menu  ·  Right stick volume  ·  B close" FontSize="11" Foreground="#484f58"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Full-screen now playing (music) -->
        <Border Background="#0d1117" IsVisible="{Binding IsNowPlayingFullScreen}" ZIndex="45" Padding="48,32">
            <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="14">
                <Button Classes="btn-secondary" HorizontalAlignment="Left" Command="{Binding CloseNowPlayingFullScreenCommand}">✕  Close</Button>
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
                    <Border Width="300" Height="300" CornerRadius="14" ClipToBounds="True" HorizontalAlignment="Center">
                        <views:CoverImage FallbackText="{Binding NowPlaying.DisplayTitle}"
                                          FallbackGradient="{Binding NowPlaying.Gradient}"
                                          LocalCachePath="{Binding NowPlaying.CoverPath}"
                                          LetterFontSize="140" ImageCornerRadius="14" Width="300" Height="300"/>
                    </Border>
                    <TextBlock Text="{Binding NowPlayingTitle}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="800"/>
                    <TextBlock Text="{Binding NowPlayingGroup}" FontSize="14" Foreground="#8b949e" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding NowPlaying.RatingStars}" Foreground="#f5c518" FontSize="16"/>
                        <TextBlock Text="{Binding NowPlaying.PlayCountLabel}" Foreground="#8b949e" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MaxWidth="900">
                    <TextBlock Text="{Binding PositionLabel}" FontSize="12" Foreground="#c9d1d9" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Background="Transparent" Padding="0,8" Cursor="Hand" Tag="audio"
                            PointerPressed="OnSeekPressed" PointerMoved="OnSeekMoved" PointerReleased="OnSeekReleased">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="10" IsHitTestVisible="False"/>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding DurationLabel}" FontSize="12" Foreground="#c9d1d9" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                    <Button Classes="btn-secondary media-nav" Classes.focused="{Binding IsMusicTransportFocus0}" Command="{Binding PreviousTrackCommand}" Content="⏮"/>
                    <Button Classes="btn-secondary media-nav" Classes.focused="{Binding IsMusicTransportFocus1}" Command="{Binding MusicSeekBackCommand}" Content="⏪"/>
                    <Button Classes="btn-primary media-nav" Classes.focused="{Binding IsMusicTransportFocus2}" MinWidth="72" HorizontalContentAlignment="Center"
                            Command="{Binding TogglePlayPauseCommand}" Content="{Binding PlayPauseGlyph}"/>
                    <Button Classes="btn-secondary media-nav" Classes.focused="{Binding IsMusicTransportFocus3}" Command="{Binding MusicSeekForwardCommand}" Content="⏩"/>
                    <Button Classes="btn-secondary media-nav" Classes.focused="{Binding IsMusicTransportFocus4}" Command="{Binding NextTrackCommand}" Content="⏭"/>
                    <Button Classes="btn-secondary media-nav" Classes.focused="{Binding IsMusicTransportFocus5}" Command="{Binding StopMusicCommand}" Content="⏹"/>
                </StackPanel>
                <TextBlock Grid.Row="4" Text="◀ ▶ choose button  ·  A press  ·  X pause  ·  LT / RT seek  ·  ▲ ▼ previous / next track  ·  LB / RB rate  ·  B close"
                           FontSize="11" Foreground="#484f58" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Volume HUD (right stick) -->
        <Border IsVisible="{Binding IsVolumeHudVisible}" ZIndex="70" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,90"
                Background="#E6161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="10" Padding="18,10" IsHitTestVisible="False">
            <TextBlock Text="{Binding VolumeLabel}" FontSize="18" FontWeight="Bold"/>
        </Border>

        <!-- Options menu (Start) -->
        <Border IsVisible="{Binding IsMusicMenuOpen}" Background="#B0000000" ZIndex="80">
            <Border Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="12" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="380" MaxWidth="560">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding MusicMenuTitle}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding MusicMenuEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MediaViewModel+MusicMenuEntry">
                                <Button Classes="btn-secondary media-nav" Classes.focused="{Binding IsFocused}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                        Command="{Binding $parent[UserControl].DataContext.ActivateMusicMenuEntryCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding Label}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="A select · B / Y close" FontSize="11" Foreground="#8b949e"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- On-screen keyboard (search / playlist name) -->
        <Border IsVisible="{Binding MusicKeyboard.IsOpen}" Background="#B0000000" ZIndex="90">
            <views:OnScreenKeyboardView DataContext="{Binding MusicKeyboard}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
</Panel>
</UserControl>
