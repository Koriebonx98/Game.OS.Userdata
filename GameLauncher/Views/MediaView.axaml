<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             xmlns:vlc="using:LibVLCSharp.Avalonia"
             xmlns:lib="using:GameLauncher.Views.MediaLib"
             x:Class="GameLauncher.Views.MediaView"
             x:DataType="vm:MediaViewModel">

    <Panel>
        <!--
            Media page. The layouts live in separate files chosen by Settings -> Design:
              Views/MediaLib/Default.MoviesTv.axaml  ("Default")   Views/MediaLib/Netflix.MoviesTv.axaml ("Netflix")
              Views/MediaLib/Default.Music.axaml     ("Default")   Views/MediaLib/Spotify.Music.axaml    ("Spotify")
        -->
        <Panel IsVisible="{Binding !IsVlcPlayerOpen}">
            <Panel IsVisible="{Binding IsVideoSection}">
                <lib:DefaultMoviesTv IsVisible="{Binding IsDefaultMoviesTv}"/>
                <lib:NetflixMoviesTv IsVisible="{Binding IsNetflixMoviesTv}"/>
            </Panel>
            <Panel IsVisible="{Binding IsMusicSelected}">
                <lib:DefaultMusic IsVisible="{Binding IsDefaultMusic}"/>
                <lib:SpotifyMusic IsVisible="{Binding IsSpotifyMusic}"/>
            </Panel>
        </Panel>

        <!-- VLC player overlay (shown when IsVlcPlayerOpen) -->
        <Border Background="#0d1117"
                IsVisible="{Binding IsVlcPlayerOpen}"
                ZIndex="50">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Top bar -->
                <Border Grid.Row="0" Background="#161b22" Padding="16,10">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0"
                                Classes="btn-secondary"
                                Padding="10,6"
                                Command="{Binding CloseVlcPlayerCommand}">
                            ✕  Close
                        </Button>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding VlcMediaPath}"
                                   FontSize="13"
                                   Foreground="#c9d1d9"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2"
                                   Text="🎬 VLC Player"
                                   FontSize="12"
                                   Foreground="#8b949e"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Video surface -->
                <vlc:VideoView Grid.Row="1"
                               x:Name="VlcOverlayVideoView"/>

                <!-- Bottom hint -->
                <Border Grid.Row="2" Background="#161b22" Padding="16,8">
                    <TextBlock Text="Powered by VLC · press Close to stop playback"
                               FontSize="11"
                               Foreground="#484f58"
                               HorizontalAlignment="Center"/>
                </Border>

            </Grid>
        </Border>

    </Panel>
</UserControl>
