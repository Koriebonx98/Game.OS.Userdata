<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             xmlns:m="using:GameLauncher.Models"
             xmlns:views="using:GameLauncher.Views"
             x:Class="GameLauncher.Views.DownloadsView"
             x:DataType="vm:DownloadsViewModel">
    <Panel>
    <DockPanel Margin="32,24">
        <TextBlock DockPanel.Dock="Top" Text="Downloads" FontSize="26" FontWeight="Bold" Foreground="White"/>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,14">
            <TextBox Grid.Column="0" Classes="form-input" Text="{Binding NewUrl, Mode=TwoWay}"
                     Watermark="Paste a direct link, .torrent URL or magnet:  (Y: keyboard)"/>
            <Button Grid.Column="1" Content="Add" Classes="btn-primary" Command="{Binding AddUrlCommand}"/>
            <Button Grid.Column="2" Content="Pause all" Classes="btn-secondary" Command="{Binding PauseAllCommand}"/>
            <Button Grid.Column="3" Content="Resume all" Classes="btn-secondary" Command="{Binding ResumeAllCommand}"/>
            <Button Grid.Column="4" Content="Clear finished" Classes="btn-secondary" Command="{Binding ClearFinishedCommand}"/>
        </Grid>
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="11" Foreground="#8b949e"
                   Text="↑/↓: select · A: pause / resume / open folder · X: remove · Y: add link (keyboard) · ←: menu"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" Foreground="#58a6ff" FontSize="12" Margin="0,0,0,8"/>
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:DownloadItem">
                        <Border Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8"
                                Classes.sel="{Binding IsSelected}">
                            <Border.Styles>
                                <Style Selector="Border.sel"><Setter Property="BorderBrush" Value="#58a6ff"/><Setter Property="BorderThickness" Value="2"/></Style>
                            </Border.Styles>
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <Border Background="#21262d" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding KindLabel}" FontSize="10" Foreground="#8b949e"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Content="⏸" Command="{ReflectionBinding $parent[UserControl].DataContext.PauseCommand}" CommandParameter="{Binding}" IsVisible="{Binding CanPause}"/>
                                    <Button Content="▶" Command="{ReflectionBinding $parent[UserControl].DataContext.ResumeCommand}" CommandParameter="{Binding}" IsVisible="{Binding CanResume}"/>
                                    <Button Content="📂" Command="{ReflectionBinding $parent[UserControl].DataContext.OpenFolderCommand}" CommandParameter="{Binding}"/>
                                    <Button Content="✕" Command="{ReflectionBinding $parent[UserControl].DataContext.RemoveCommand}" CommandParameter="{Binding}"/>
                                    <Button Content="🗑" ToolTip.Tip="Remove and delete files" Command="{ReflectionBinding $parent[UserControl].DataContext.RemoveWithFilesCommand}" CommandParameter="{Binding}"/>
                                </StackPanel>
                                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8" Minimum="0" Maximum="100" Value="{Binding Progress}" Height="6"/>
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" FontSize="11" Foreground="#8b949e">
                                    <Run Text="{Binding StatusText}"/><Run Text="  ·  "/><Run Text="{Binding TargetLabel}"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
    <views:OnScreenKeyboardView DataContext="{Binding Keyboard}"/>
    </Panel>
</UserControl>
