<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             xmlns:models="using:GameLauncher.Models"
             xmlns:views="using:GameLauncher.Views"
             x:Class="GameLauncher.Views.FriendsView"
             x:DataType="vm:FriendsViewModel"
             Background="#0d1117">

    <UserControl.Resources>
        <DataTemplate x:Key="FriendTile" x:DataType="models:FriendEntry">
            <Border Classes="con-tile" Classes.sel="{Binding IsSelected}"
                    views:BringIntoViewBehavior.Active="{Binding IsSelected}">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="68,*,Auto">
                        <Panel Width="54" Height="54" HorizontalAlignment="Left">
                            <Border Classes="con-avatar">
                                <TextBlock Text="{Binding AvatarInitial}" FontSize="22" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Panel>
                        <Border Grid.Column="0" Width="14" Height="14" CornerRadius="7" Background="#3fb950"
                                BorderBrush="#141a22" BorderThickness="2" Margin="0,0,10,0"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                IsVisible="{Binding IsOnline}"/>
                        <Border Grid.Column="0" Width="14" Height="14" CornerRadius="7" Background="#e8960c"
                                BorderBrush="#141a22" BorderThickness="2" Margin="0,0,10,0"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                IsVisible="{Binding IsAway}"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding Username}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                <Border CornerRadius="8" Padding="7,2" Background="#21262d" VerticalAlignment="Center"
                                        IsVisible="{Binding GamerScoreLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{Binding GamerScoreLabel}" FontSize="10" FontWeight="Bold" Foreground="#f1c40f"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Classes="con-dot" Classes.online="{Binding IsOnline}" Classes.away="{Binding IsAway}"/>
                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#8b949e" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LastSeen}" FontSize="12" Foreground="#6e7681" VerticalAlignment="Center"
                                           IsVisible="{Binding !IsOnline}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding CurrentGame, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="🎮 Playing" FontSize="12" Foreground="#8b949e" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentGame}" FontSize="12" FontWeight="SemiBold" Foreground="#58a6ff"
                                           VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                                <Border Background="#21262d" CornerRadius="6" Padding="6,1" VerticalAlignment="Center"
                                        IsVisible="{Binding RecentGamePlatform, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{Binding RecentGamePlatform}" FontSize="10" FontWeight="Bold" Foreground="#8b949e"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding RecentGameTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="Last played" FontSize="12" Foreground="#6e7681" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding RecentGameTitle}" FontSize="12" Foreground="#8b949e"
                                           VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="con-act"
                                    Command="{Binding $parent[UserControl].DataContext.OpenConversationCommand}"
                                    CommandParameter="{Binding Username}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Classes="con-btn a"><TextBlock Text="A"/></Border>
                                    <TextBlock Text="Message"/>
                                </StackPanel>
                                </Button>
                            <Button Classes="con-act">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Classes="con-btn x"><TextBlock Text="X"/></Border>
                                    <TextBlock Text="Invite"/>
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuItem Header="Crossplay"
                                                  Command="{Binding $parent[UserControl].DataContext.InviteFriendViaConnectionCommand}"
                                                  CommandParameter="{Binding Username, StringFormat='{}{0}|Crossplay'}"/>
                                        <MenuItem Header="Radmin"
                                                  Command="{Binding $parent[UserControl].DataContext.InviteFriendViaConnectionCommand}"
                                                  CommandParameter="{Binding Username, StringFormat='{}{0}|Radmin'}"/>
                                        <MenuItem Header="OnlineFix"
                                                  Command="{Binding $parent[UserControl].DataContext.InviteFriendViaConnectionCommand}"
                                                  CommandParameter="{Binding Username, StringFormat='{}{0}|OnlineFix'}"/>
                                        <MenuItem Header="Steam"
                                                  Command="{Binding $parent[UserControl].DataContext.InviteFriendViaConnectionCommand}"
                                                  CommandParameter="{Binding Username, StringFormat='{}{0}|Steam'}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button Classes="con-act"
                                    Command="{Binding $parent[UserControl].DataContext.ViewFriendProfileCommand}"
                                    CommandParameter="{Binding Username}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Classes="con-btn y"><TextBlock Text="Y"/></Border>
                                    <TextBlock Text="Profile"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="con-act" Padding="12,5"
                                    ToolTip.Tip="Manage network IPs for direct connect"
                                    Command="{Binding $parent[UserControl].DataContext.ToggleFriendIpPanelCommand}"
                                    CommandParameter="{Binding Username}">
                                <TextBlock Text="🌐"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding IpAddresses}"
                                  IsVisible="{Binding HasIpAddresses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:FriendIpEntry">
                                <Grid ColumnDefinitions="*,Auto" Margin="68,0,0,4">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Background="#21262d" CornerRadius="6" Padding="6,2">
                                            <TextBlock Text="{Binding TypeLabel}" FontSize="10" FontWeight="Bold" Foreground="#58a6ff"/>
                                        </Border>
                                        <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Address}" FontSize="12" Foreground="#8b949e" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Padding="8,4" Classes="btn-secondary" Foreground="#f85149"
                                            VerticalAlignment="Center" FontSize="11"
                                            Command="{Binding $parent[UserControl].DataContext.RemoveFriendIpCommand}"
                                            CommandParameter="{Binding}">✕</Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>


    <Grid RowDefinitions="*,Auto,Auto">

    <!-- ── Friends list (scrollable) ── -->
    <ScrollViewer Grid.Row="0"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="40,32,40,28" Spacing="0">

        <!-- Header -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,22">
            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock Text="FRIENDS" Classes="con-title"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="con-pill">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Border Classes="con-dot online"/>
                            <TextBlock Foreground="#c9d1d9" FontSize="12" VerticalAlignment="Center">
                                <Run Text="{Binding OnlineCount}"/><Run Text=" online"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Classes="con-pill">
                        <TextBlock Foreground="#c9d1d9" FontSize="12">
                            <Run Text="{Binding TotalCount}"/><Run Text=" friends"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Classes="con-act" VerticalAlignment="Center"
                    Command="{Binding OpenAddFriendKeyboardCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="con-btn s"><TextBlock Text="≡"/></Border>
                    <TextBlock Text="Add Friend"/>
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock Text="Loading friends…"
                   Foreground="#8b949e" FontSize="13" Margin="0,0,0,16"
                   IsVisible="{Binding IsLoading}"/>

        <Border Background="#3d1a1a" CornerRadius="10" Padding="14,10"
                Margin="0,0,0,16"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#f85149" FontSize="13"/>
        </Border>

        <Border Background="#132238" BorderBrush="#1f3a5f" BorderThickness="1" CornerRadius="10" Padding="14,10"
                Margin="0,0,0,16"
                IsVisible="{Binding InviteStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding InviteStatusMessage}"
                       Foreground="#58a6ff" FontSize="13"/>
        </Border>

        <!-- ── Friend requests ── -->
        <StackPanel IsVisible="{Binding PendingRequests.Count}" Margin="0,0,0,18">
            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,10">
                <TextBlock Text="FRIEND REQUESTS" Classes="con-section"/>
                <Border Grid.Column="1" Height="1" Background="#222a35" Margin="14,0,0,0"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding PendingRequests}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:FriendRequestDisplay">
                        <Border Classes="con-tile" Classes.sel="{Binding IsSelected}"
                                views:BringIntoViewBehavior.Active="{Binding IsSelected}">
                            <Grid ColumnDefinitions="68,*,Auto,Auto">
                                <Border Classes="con-avatar">
                                    <TextBlock Text="{Binding AvatarInitial}" FontSize="22" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding FromUsername}" FontSize="17" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock FontSize="12" Foreground="#8b949e">
                                        <Run Text="Wants to be friends · "/><Run Text="{Binding SentAgo}"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="2" Classes="con-act" Margin="0,0,8,0"
                                        Command="{Binding $parent[UserControl].DataContext.AcceptRequestCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="con-btn a"><TextBlock Text="A"/></Border>
                                        <TextBlock Text="Accept"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Classes="con-act"
                                        Command="{Binding $parent[UserControl].DataContext.DeclineRequestCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="con-btn x"><TextBlock Text="X"/></Border>
                                        <TextBlock Text="Decline"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- ── Online ── -->
        <StackPanel IsVisible="{Binding OnlineFriends.Count}" Margin="0,0,0,18">
            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,10">
                <TextBlock Text="ONLINE" Classes="con-section"/>
                <Border Grid.Column="1" Height="1" Background="#222a35" Margin="14,0,0,0"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding OnlineFriends}" ItemTemplate="{StaticResource FriendTile}"/>
        </StackPanel>

        <!-- ── Offline ── -->
        <StackPanel IsVisible="{Binding OfflineFriends.Count}">
            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,10">
                <TextBlock Text="OFFLINE" Classes="con-section"/>
                <Border Grid.Column="1" Height="1" Background="#222a35" Margin="14,0,0,0"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding OfflineFriends}" ItemTemplate="{StaticResource FriendTile}"/>
        </StackPanel>

        <!-- ── Add IP panel — shown when a friend's 🌐 button is clicked ── -->
        <Border Background="#161b22" CornerRadius="12" Padding="20,16"
                Margin="0,8,0,0"
                IsVisible="{Binding ExpandedIpFriend, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <StackPanel Spacing="12">
                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🌐" FontSize="16"/>
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="White">
                            <Run Text="Network IPs for "/>
                            <Run Text="{Binding ExpandedIpFriend}" FontWeight="Bold"
                                 Foreground="#58a6ff"/>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="btn-secondary" Padding="10,6"
                            Command="{Binding ToggleFriendIpPanelCommand}"
                            CommandParameter="{Binding ExpandedIpFriend}">
                        ✕ Close
                    </Button>
                </Grid>

                <!-- Existing IPs for this friend -->
                <ItemsControl ItemsSource="{Binding SelectedFriendForIps.IpAddresses}"
                              IsVisible="{Binding SelectedFriendForIps.HasIpAddresses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:FriendIpEntry">
                            <Grid ColumnDefinitions="Auto,*,*,Auto" Margin="0,0,0,6">
                                <Border Grid.Column="0" Background="#21262d" CornerRadius="4"
                                        Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding TypeLabel}" FontSize="10"
                                               FontWeight="Bold" Foreground="#58a6ff"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Label}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Address}"
                                           FontSize="13" Foreground="#8b949e"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Padding="8,4"
                                        Classes="btn-secondary" Foreground="#f85149"
                                        VerticalAlignment="Center" FontSize="11"
                                        Command="{Binding $parent[UserControl].DataContext.RemoveFriendIpCommand}"
                                        CommandParameter="{Binding}">✕</Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No IPs saved yet."
                           FontSize="12" Foreground="#484f58"
                           IsVisible="{Binding !SelectedFriendForIps.HasIpAddresses}"/>

                <!-- Separator -->
                <Border Height="1" Background="#30363d" Margin="0,4,0,0"/>

                <!-- Add new IP form -->
                <TextBlock Text="Add IP Address" FontSize="13" FontWeight="SemiBold"
                           Foreground="#8b949e"/>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                    <!-- Label -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Label" FontSize="11"
                               Foreground="#8b949e" Margin="0,0,0,4"/>
                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding NewIpLabel}"
                             Watermark="e.g. Home, Work…"
                             Margin="0,0,8,0"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <!-- Address -->
                    <TextBox Grid.Column="0" Text="{Binding NewIpAddress}"
                             Watermark="IP address (e.g. 26.x.x.x)"
                             Margin="0,0,8,0"/>
                    <!-- Type picker -->
                    <ComboBox Grid.Column="1" SelectedItem="{Binding NewIpType}"
                              Margin="0,0,8,0" MinWidth="100">
                        <ComboBoxItem Content="local"/>
                        <ComboBoxItem Content="radmin"/>
                        <ComboBoxItem Content="zerotier"/>
                        <ComboBoxItem Content="hamachi"/>
                    </ComboBox>
                    <!-- Add button -->
                    <Button Grid.Column="2" Classes="btn-primary" Padding="14,8"
                            Command="{Binding AddFriendIpCommand}"
                            CommandParameter="{Binding ExpandedIpFriend}">
                        + Add
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Empty state — shown when not loading and no friends found -->
        <TextBlock Text="No friends yet. Add friends to see them here."
                   Foreground="#8b949e" FontSize="13" HorizontalAlignment="Center"
                   Margin="0,32,0,0"
                   IsVisible="{Binding HasNoFriends}"/>

    </StackPanel>
    </ScrollViewer>

    <!-- ── Inline conversation panel ── -->
    <Border Grid.Row="1"
            Background="#161b22"
            BorderBrush="#30363d"
            BorderThickness="0,1,0,0"
            IsVisible="{Binding ShowConversation}">
        <Grid RowDefinitions="Auto,*,Auto" MaxHeight="340">

            <!-- Conversation header -->
            <Border Grid.Row="0" Padding="16,10" Background="#1c2128">
                <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Text="💬" FontSize="16"/>
                    <TextBlock Text="{Binding ConversationFriend}"
                               FontSize="14" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="btn-secondary" Padding="10,6"
                        Command="{Binding CloseConversationCommand}">
                    ✕
                </Button>
                </Grid>
            </Border>

            <!-- Message list -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Padding="16,8">
                <StackPanel Spacing="8">
                    <!-- Message error -->
                    <TextBlock Text="{Binding MessageError}"
                               Foreground="#f85149" FontSize="12"
                               IsVisible="{Binding MessageError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <!-- No messages yet -->
                    <TextBlock Text="No messages yet. Say hello!"
                               Foreground="#8b949e" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,16,0,0"
                               IsVisible="{Binding !ConversationMessages.Count}"/>
                    <!-- Message bubbles -->
                    <ItemsControl ItemsSource="{Binding ConversationMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Message">
                                <Border CornerRadius="12" Padding="12,8" Background="#1c2430"
                                        Margin="0,2">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding From}"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="#1f6feb"/>
                                        <TextBlock Text="{Binding Text}"
                                                   FontSize="13" Foreground="#c9d1d9"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Send message input -->
            <Border Grid.Row="2" Padding="12,10" Background="#1c2128">
                <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding NewMessageText}"
                         Watermark="Type a message…"
                         Background="#21262d"
                         Foreground="White"
                         BorderBrush="#30363d"
                         CornerRadius="8"
                         Padding="10,8"
                         Margin="0,0,8,0"/>
                <Button Grid.Column="1"
                        Classes="btn-primary"
                        Padding="16,8"
                        IsEnabled="{Binding !IsSendingMessage}"
                        Command="{Binding SendMessageCommand}">
                    Send ➤
                </Button>
                </Grid>
            </Border>

        </Grid>
    </Border>


    <!-- ── Console button prompts ── -->
    <Border Grid.Row="2" Classes="con-bar">
        <StackPanel Orientation="Horizontal" Spacing="26">
            <StackPanel Orientation="Horizontal" Spacing="7"><Border Classes="con-btn s"><TextBlock Text="↕"/></Border><TextBlock Classes="con-bar-text" Text="Select"/></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7"><Border Classes="con-btn a"><TextBlock Text="A"/></Border><TextBlock Classes="con-bar-text" Text="Message / Accept"/></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7"><Border Classes="con-btn x"><TextBlock Text="X"/></Border><TextBlock Classes="con-bar-text" Text="Invite / Decline"/></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7"><Border Classes="con-btn y"><TextBlock Text="Y"/></Border><TextBlock Classes="con-bar-text" Text="Profile"/></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7"><Border Classes="con-btn s"><TextBlock Text="≡"/></Border><TextBlock Classes="con-bar-text" Text="Add Friend"/></StackPanel>
        </StackPanel>
    </Border>

    <views:OnScreenKeyboardView Grid.RowSpan="3" DataContext="{Binding Keyboard}"/>
    </Grid>
</UserControl>
