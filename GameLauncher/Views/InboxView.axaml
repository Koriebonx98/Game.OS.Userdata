<UserControl xmlns:svc="using:GameLauncher.Services" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             xmlns:models="using:GameLauncher.Models"
             xmlns:views="using:GameLauncher.Views"
             x:Class="GameLauncher.Views.InboxView"
             x:DataType="vm:InboxViewModel"
             Background="#0d1117">

    <Grid RowDefinitions="*,Auto,Auto">

        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,32,40,28" Spacing="0">

                <StackPanel Spacing="8" Margin="0,0,0,22">
                    <TextBlock Text="INBOX" Classes="con-title"/>
                    <TextBlock Text="Messages, game invites and shared mods." Classes="page-subtitle"/>
                </StackPanel>

                <TextBlock Text="Loading inbox…"
                           Foreground="#8b949e" FontSize="13" Margin="0,0,0,16"
                           IsVisible="{Binding IsLoading}"/>

                <Border Background="#3d1a1a" CornerRadius="10" Padding="14,10"
                        Margin="0,0,0,16"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#f85149" FontSize="13"/>
                </Border>

                <!-- ── Game invites ── -->
                <StackPanel IsVisible="{Binding HasPendingInvites}" Margin="0,0,0,18">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,10">
                        <TextBlock Text="GAME INVITES" Classes="con-section"/>
                        <Border Grid.Column="1" Height="1" Background="#222a35" Margin="14,0,0,0"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding PendingInvites}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:GameInvite">
                                <Border Classes="con-tile" Classes.sel="{Binding IsSelected}"
                                        views:BringIntoViewBehavior.Active="{Binding IsSelected}">
                                    <Grid ColumnDefinitions="68,*,Auto,Auto">
                                        <Border Classes="con-avatar" Background="#8957e5">
                                            <TextBlock Text="{Binding Glyph}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="{Binding GameName}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#8b949e" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="con-act" Margin="0,0,8,0"
                                                Command="{Binding $parent[UserControl].DataContext.AcceptInviteCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Classes="con-btn a"><TextBlock Text="A"/></Border>
                                                <TextBlock Text="{Binding AcceptLabel}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="3" Classes="con-act"
                                                Command="{Binding $parent[UserControl].DataContext.DeclineInviteCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Classes="con-btn x"><TextBlock Text="X"/></Border>
                                                <TextBlock Text="Decline"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ── Shared mods ── -->
                <StackPanel IsVisible="{Binding HasPendingModShares}" Margin="0,0,0,18">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,10">
                        <TextBlock Text="SHARED MODS" Classes="con-section"/>
                        <Border Grid.Column="1" Height="1" Background="#222a35" Margin="14,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding ModShareStatus}" FontSize="12" Foreground="#8b949e" Margin="0,0,0,8"
                               IsVisible="{Binding ModShareStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <ItemsControl ItemsSource="{Binding PendingModShares}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="svc:PendingModShare">
                                <Border Classes="con-tile" Classes.sel="{Binding IsSelected}"
                                        views:BringIntoViewBehavior.Active="{Binding IsSelected}">
                                    <Grid ColumnDefinitions="68,*,Auto,Auto">
                                        <Border Classes="con-avatar" Background="#238636">
                                            <TextBlock Text="🧩" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#8b949e" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="con-act" Margin="0,0,8,0"
                                                Command="{Binding $parent[UserControl].DataContext.AcceptModShareCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Classes="con-btn a"><TextBlock Text="A"/></Border>
                                                <TextBlock Text="Accept"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="3" Classes="con-act"
                                                Command="{Binding $parent[UserControl].DataContext.DeclineModShareCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Classes="con-btn x"><TextBlock Text="X"/></Border>
                                                <TextBlock Text="Decline"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ── Messages ── -->
                <StackPanel IsVisible="{Binding HasConversations}">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,10">
                        <TextBlock Text="MESSAGES" Classes="con-section"/>
                        <Border Grid.Column="1" Height="1" Background="#222a35" Margin="14,0,0,0"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Conversations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:InboxConversationVm">
                                <Border Classes="con-tile" Classes.sel="{Binding IsSelected}"
                                        views:BringIntoViewBehavior.Active="{Binding IsSelected}">
                                    <Grid ColumnDefinitions="68,*,Auto,Auto,Auto">
                                        <Border Classes="con-avatar">
                                            <TextBlock Text="💬" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding FriendUsername}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="{Binding LastMessage}" FontSize="12" Foreground="#8b949e"
                                                       MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding LastMessageAt}" FontSize="11" Foreground="#6e7681"
                                                   VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        <Button Grid.Column="3" Classes="con-act" Margin="0,0,8,0"
                                                Command="{Binding $parent[UserControl].DataContext.OpenConversationCommand}"
                                                CommandParameter="{Binding FriendUsername}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Classes="con-btn a"><TextBlock Text="A"/></Border>
                                                <TextBlock Text="Open"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="4" Classes="con-act"
                                                Command="{Binding $parent[UserControl].DataContext.ViewFriendProfileCommand}"
                                                CommandParameter="{Binding FriendUsername}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Classes="con-btn y"><TextBlock Text="Y"/></Border>
                                                <TextBlock Text="Profile"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="No messages or invites yet."
                           Foreground="#8b949e" FontSize="14" HorizontalAlignment="Center"
                           Margin="0,40,0,0"
                           IsVisible="{Binding HasEmptyInbox}"/>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="#161b22"
                BorderBrush="#30363d"
                BorderThickness="0,1,0,0"
                IsVisible="{Binding ShowConversation}">
            <Grid RowDefinitions="Auto,*,Auto" MaxHeight="340">

                <Border Grid.Row="0" Padding="16,10" Background="#1c2128">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center">
                            <TextBlock Text="💬" FontSize="16"/>
                            <TextBlock Text="{Binding ConversationFriend}"
                                       FontSize="14" FontWeight="Bold" Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="btn-secondary" Padding="10,6"
                                Command="{Binding CloseConversationCommand}">
                            ✕
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Padding="16,8">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding MessageError}"
                                   Foreground="#f85149" FontSize="12"
                                   IsVisible="{Binding MessageError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <ItemsControl ItemsSource="{Binding ConversationMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Message">
                                    <Border CornerRadius="12" Padding="12,8" Background="#1c2430" Margin="0,2">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding From}"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="#1f6feb"/>
                                            <TextBlock Text="{Binding Text}"
                                                       FontSize="13" Foreground="#c9d1d9"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Padding="12,10" Background="#1c2128">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding NewMessageText}"
                                 Watermark="Type a message…"
                                 Background="#21262d"
                                 Foreground="White"
                                 BorderBrush="#30363d"
                                 CornerRadius="8"
                                 Padding="10,8"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="1"
                                Classes="btn-primary"
                                Padding="16,8"
                                IsEnabled="{Binding !IsSendingMessage}"
                                Command="{Binding SendMessageCommand}">
                            Send ➤
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Classes="con-bar">
            <StackPanel Orientation="Horizontal" Spacing="26">
                <StackPanel Orientation="Horizontal" Spacing="7"><Border Classes="con-btn s"><TextBlock Text="↕"/></Border><TextBlock Classes="con-bar-text" Text="Select"/></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="7"><Border Classes="con-btn a"><TextBlock Text="A"/></Border><TextBlock Classes="con-bar-text" Text="Open / Accept"/></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="7"><Border Classes="con-btn x"><TextBlock Text="X"/></Border><TextBlock Classes="con-bar-text" Text="Decline"/></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="7"><Border Classes="con-btn y"><TextBlock Text="Y"/></Border><TextBlock Classes="con-bar-text" Text="Profile"/></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="7"><Border Classes="con-btn b"><TextBlock Text="B"/></Border><TextBlock Classes="con-bar-text" Text="Back"/></StackPanel>
            </StackPanel>
        </Border>

    <views:OnScreenKeyboardView Grid.RowSpan="3" DataContext="{Binding Keyboard}"/>
    </Grid>
</UserControl>
