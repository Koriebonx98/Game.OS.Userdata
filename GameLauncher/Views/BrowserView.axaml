<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             x:Class="GameLauncher.Views.BrowserView"
             x:DataType="vm:BrowserViewModel"
             Background="#0d1117">

    <UserControl.Styles>
        <Style Selector="Button.menu-entry.menu-hl"><Setter Property="Background" Value="#1f6feb"/></Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Tab strip -->
        <Border Grid.Row="0" Background="#010409" Padding="8,6,8,0">
            <Grid ColumnDefinitions="*,Auto">
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BrowserTabVm">
                                <Border CornerRadius="8,8,0,0" Padding="10,6" MinWidth="120" MaxWidth="220"
                                        Background="#161b22"
                                        Classes.sel="{Binding IsSelected}">
                                    <Border.Styles>
                                        <Style Selector="Border.sel"><Setter Property="Background" Value="#21262d"/></Style>
                                    </Border.Styles>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0"
                                                HorizontalContentAlignment="Left"
                                                Command="{ReflectionBinding $parent[UserControl].DataContext.SelectTabCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding Title}" Foreground="#e6edf3" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Button>
                                        <Button Grid.Column="1" Content="✕" FontSize="10" Padding="4,0" Margin="6,0,0,0"
                                                Background="Transparent" Foreground="#8b949e" BorderThickness="0"
                                                Command="{ReflectionBinding $parent[UserControl].DataContext.CloseTabCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Grid.Column="1" Content="＋" Margin="6,0,0,4" Padding="10,2" Background="#21262d" Foreground="White"
                        Command="{Binding AddTabCommand}"/>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="#161b22" Padding="8,6" BorderBrush="#21262d" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
                <Button Grid.Column="0" Content="←" Command="{Binding GoBackCommand}" Classes="btn-secondary" Padding="12,6"/>
                <Button Grid.Column="1" Content="→" Command="{Binding GoForwardCommand}" Classes="btn-secondary" Padding="12,6"/>
                <Button Grid.Column="2" Content="⟳" Command="{Binding ReloadCommand}" Classes="btn-secondary" Padding="12,6"/>
                <Button Grid.Column="3" Content="⌂" Command="{Binding GoHomeCommand}" Classes="btn-secondary" Padding="12,6"/>
                <TextBox Grid.Column="4" x:Name="AddressBox" Classes="form-input"
                         Text="{Binding AddressText, Mode=TwoWay}" Watermark="🔍  Search or enter address  (Y)"
                         KeyDown="OnAddressKeyDown"/>
                <TextBlock Grid.Column="5" VerticalAlignment="Center" Foreground="#3fb950" FontSize="12"
                           IsVisible="{Binding AdBlockOn}" Text="🛡 Ad block ON"/>
                <Button Grid.Column="6" Content="★" Command="{Binding ToggleFavouriteCommand}" Classes="btn-secondary" Padding="12,6"/>
                <Button Grid.Column="7" Content="☰" Click="OnMenuClick" Classes="btn-secondary" Padding="12,6"/>
            </Grid>
        </Border>

        <!-- Page area: WebViews are added here in code; the Start-button menu is drawn on top (WebViews are hidden while it is open) -->
        <Panel Grid.Row="2" x:Name="WebHost" ClipToBounds="True">
            <Border x:Name="MenuOverlay" IsVisible="{Binding IsMenuOpen}" Background="#E6010409" ZIndex="10">
                <Border Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="16" Padding="16"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="420" MaxHeight="520">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="BROWSER MENU" FontSize="14" FontWeight="Bold" Foreground="#8b949e" Margin="8,0,0,10"/>
                        <TextBlock DockPanel.Dock="Bottom" Text="D-pad: move · A: select · X: delete favourite · B / Start: close"
                                   FontSize="11" Foreground="#8b949e" Margin="8,10,0,0"/>
                        <ScrollViewer x:Name="MenuScroll" VerticalScrollBarVisibility="Hidden">
                            <ItemsControl x:Name="MenuList" ItemsSource="{Binding MenuEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BrowserMenuEntry">
                                        <Button Classes="btn-secondary menu-entry" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Margin="0,0,0,4" Content="{Binding Label}"
                                                Command="{ReflectionBinding $parent[UserControl].DataContext.ActivateMenuCommand}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Border>
        </Panel>

        <!-- Controller hints -->
        <Border Grid.Row="3" Background="#010409" Padding="12,6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" FontSize="11" Foreground="#8b949e" VerticalAlignment="Center"
                           Text="L-stick: mouse · R-stick: scroll · A: click · X: right-click · Y: search · B: back · Start: menu · LB/RB: tabs"/>
                <TextBlock Grid.Column="1" FontSize="11" Foreground="#58a6ff" Text="{Binding StatusText}" Margin="12,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
