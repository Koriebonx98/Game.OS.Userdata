<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             xmlns:lib="using:GameLauncher.Views.GamesLib"
             x:Class="GameLauncher.Views.LibraryView"
             x:DataType="vm:LibraryViewModel"
             Background="#0d1117">

    <!--
        Host for the Games page. The layout lives in separate, easy-to-edit files chosen by
        Settings → Design → Games:
          Views/GamesLib/Default.Games.Lib.axaml   ("Default")
          Views/GamesLib/PS5.Games.Lib.axaml       ("PS5")
    -->
    <Panel>
        <lib:DefaultGamesLib Name="DefaultLib" IsVisible="{Binding IsDefaultGamesLib}"/>
        <lib:Ps5GamesLib     Name="Ps5Lib"     IsVisible="{Binding IsPs5GamesLib}"/>
        <lib:GamesLibOverlays/>
    </Panel>
</UserControl>
