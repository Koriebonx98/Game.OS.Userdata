<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             xmlns:views="using:GameLauncher.Views"
             xmlns:models="using:GameLauncher.Models"
             xmlns:dash="using:GameLauncher.Views.DashboardLib"
             x:Class="GameLauncher.Views.DashboardView"
             x:DataType="vm:DashboardViewModel"
             Classes="dashboard-root">

    <!--
        Host for the Dashboard. Each theme's layout lives in its own file; the active one is shown
        by the theme styles in Styles/*Theme.axaml (Border.dashboard-*-layout / StackPanel.dashboard-default-layout):
          Views/DashboardLib/XB360.Dashboard.axaml     (Xbox 360)
          Views/DashboardLib/PS5.Dashboard.axaml       (PS5)
          Views/DashboardLib/Switch.Dashboard.axaml    (Nintendo Switch)
          Views/DashboardLib/Wii.Dashboard.axaml       (Wii)
          Views/DashboardLib/SteamBPM.Dashboard.axaml  (Steam Big Picture)
          Views/DashboardLib/Default.Dashboard.axaml   (Default / GameOS)
    -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="DashAccent" Color="#58a6ff"/>
    </UserControl.Resources>
    <!-- Stage: carries the per-design size / position / accent chosen in Settings → Design → ⚙ (see DashboardView.axaml.cs) -->
    <Grid x:Name="Stage">
        <dash:Xb360Dashboard/>
        <dash:Ps5Dashboard/>
        <dash:SwitchDashboard/>
        <dash:WiiDashboard/>
        <dash:SteamBpmDashboard/>
        <dash:DefaultDashboard/>
    </Grid>
</UserControl>
