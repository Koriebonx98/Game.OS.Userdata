<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             xmlns:set="using:GameLauncher.Views.SettingsLib"
             x:Class="GameLauncher.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="#0d1117">

    <!--
        Host for the Settings page. The layout lives in a separate, easy-to-edit file:
          Views/SettingsLib/Default.Settings.axaml   ("Default")
        Add further themed layouts next to it and show them here.
    -->
    <set:DefaultSettings Name="DefaultSettingsView"/>
</UserControl>
