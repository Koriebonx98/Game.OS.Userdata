<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             x:Class="GameLauncher.Views.DownloadPromptView"
             x:DataType="vm:DownloadsViewModel">
    <Border Background="#E6010409" IsVisible="{Binding IsPromptOpen}">
        <Border Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="16" Padding="24"
                HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
            <StackPanel Spacing="12">
                <TextBlock Text="New download" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding PromptName}" Foreground="#8b949e" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="TYPE" FontSize="11" Foreground="#8b949e"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Game" Command="{Binding SetCategoryCommand}" CommandParameter="Game" Classes.on="{Binding IsGameCategory}"/>
                    <Button Content="Mod" Command="{Binding SetCategoryCommand}" CommandParameter="Mod" Classes.on="{Binding IsModCategory}"/>
                    <Button Content="Other" Command="{Binding SetCategoryCommand}" CommandParameter="Other" Classes.on="{Binding IsOtherCategory}"/>
                </StackPanel>
                <TextBlock Text="PLATFORM" FontSize="11" Foreground="#8b949e"/>
                <ComboBox ItemsSource="{Binding PlatformNames}" SelectedItem="{Binding PromptPlatform, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                <TextBlock Text="{Binding PromptFolder}" FontSize="11" Foreground="#58a6ff" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Cancel (B)" Classes="btn-secondary" Command="{Binding CancelPromptCommand}"/>
                    <Button Content="Start download" Classes="btn-primary" Command="{Binding ConfirmPromptCommand}"/>
                </StackPanel>
                <TextBlock Text="D-pad ←/→: change · ↑/↓: row · A: next / start" FontSize="11" Foreground="#8b949e"/>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
