<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             xmlns:views="using:GameLauncher.Views"
             x:Class="GameLauncher.Views.GamesLib.XbOneGamesLib"
             x:DataType="vm:LibraryViewModel"
             Background="#101010">

    <!--
        XBOne.Games.Lib - Xbox One "Full library": left rail (user + sections), big title, filter pills,
        search, and a grid of square cover tiles with a white focus border.
        Edit this file to change the "XBOne" Games theme.
    -->
    <UserControl.Styles>
        <Style Selector="Button.xl-card">
            <Setter Property="Width" Value="206"/>
            <Setter Property="Height" Value="206"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.xl-card /template/ ContentPresenter">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3"/>
        </Style>
        <Style Selector="Button.xl-card:pointerover /template/ ContentPresenter, Button.xl-card.focused /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="White"/>
        </Style>
        <Style Selector="Button.xl-card.focused">
            <Setter Property="ZIndex" Value="5"/>
        </Style>

        <Style Selector="Button.xl-pill">
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.xl-pill /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="24"/>
        </Style>
        <Style Selector="Button.xl-pill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2d2d2d"/>
        </Style>
        <Style Selector="Button.xl-pill.filter-chip-active /template/ ContentPresenter">
            <Setter Property="Background" Value="#c8102e"/>
        </Style>

        <Style Selector="Button.xl-side">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="30,16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style Selector="Button.xl-side /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,5,0"/>
        </Style>
        <Style Selector="Button.xl-side:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2a2a2a"/>
        </Style>
        <Style Selector="Button.xl-side.filter-chip-active /template/ ContentPresenter">
            <Setter Property="Background" Value="#262626"/>
            <Setter Property="BorderBrush" Value="#c8102e"/>
        </Style>
        <Style Selector="Border.xl-badge">
            <Setter Property="Background" Value="#CC000000"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="330,*">

        <!-- Left rail -->
        <Border Grid.Column="0" Background="#171717" BorderBrush="#2a2a2a" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="30,50,0,36">
                    <Border Width="44" Height="44" CornerRadius="22" Background="#107c10">
                        <TextBlock Text="🎮" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="My library" FontSize="20" Foreground="#b0b0b0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Classes="xl-side" Classes.filter-chip-active="{Binding IsInstallFilterAll}"
                            Command="{Binding SetInstallFilterCommand}" CommandParameter="All">
                        <Grid ColumnDefinitions="40,*,Auto">
                            <TextBlock Text="▦" FontSize="20"/>
                            <TextBlock Grid.Column="1" Text="Full library" FontSize="22"/>
                            <TextBlock Grid.Column="2" Text="{Binding TotalGames}" FontSize="20" Foreground="#b0b0b0"/>
                        </Grid>
                    </Button>
                    <Button Classes="xl-side" Classes.filter-chip-active="{Binding IsInstallFilterInstalled}"
                            Command="{Binding SetInstallFilterCommand}" CommandParameter="Installed">
                        <Grid ColumnDefinitions="40,*">
                            <TextBlock Text="⭳" FontSize="20"/>
                            <TextBlock Grid.Column="1" Text="Installed" FontSize="22"/>
                        </Grid>
                    </Button>
                    <Button Classes="xl-side" Classes.filter-chip-active="{Binding IsInstallFilterNotInstalled}"
                            Command="{Binding SetInstallFilterCommand}" CommandParameter="Uninstalled">
                        <Grid ColumnDefinitions="40,*">
                            <TextBlock Text="☁" FontSize="20"/>
                            <TextBlock Grid.Column="1" Text="Not installed" FontSize="22"/>
                        </Grid>
                    </Button>
                    <Border Height="1" Background="#2f2f2f" Margin="36,14"/>
                    <TextBlock Text="Platform" FontSize="16" Foreground="#b0b0b0" Margin="34,0,0,6"/>
                    <ComboBox ItemsSource="{Binding Platforms}" SelectedItem="{Binding FilterPlatform}"
                              HorizontalAlignment="Stretch" Margin="30,0,30,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="30,0,30,36" Spacing="4">
                    <TextBlock Text="{Binding FocusedGame.EffectiveTitle}" FontSize="19" Foreground="White" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding FocusedGame.PlaytimeLabel}" FontSize="16" Foreground="#b0b0b0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" Margin="64,40,0,0">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,56,0">
                <TextBlock Text="Full library" FontSize="52" FontWeight="Light" Foreground="White"/>
                <TextBox Grid.Column="1" Name="LibrarySearchBox" Classes="form-input" IsTabStop="False"
                         Text="{Binding SearchText}" Watermark="🔍  Search" Width="270" VerticalAlignment="Center"/>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,22,0,6">
                <Button Classes="xl-pill" Classes.filter-chip-active="{Binding IsInstallFilterAll}"
                        Command="{Binding SetInstallFilterCommand}" CommandParameter="All" Content="All games"/>
                <Button Classes="xl-pill" Classes.filter-chip-active="{Binding IsInstallFilterInstalled}"
                        Command="{Binding SetInstallFilterCommand}" CommandParameter="Installed" Content="Installed games"/>
                <Button Classes="xl-pill" Classes.filter-chip-active="{Binding IsInstallFilterNotInstalled}"
                        Command="{Binding SetInstallFilterCommand}" CommandParameter="Uninstalled" Content="Not installed"/>
                <TextBlock Text="{Binding TotalGames, StringFormat='{}{0} games'}" FontSize="19" Foreground="#b0b0b0"
                           VerticalAlignment="Center" Margin="24,0,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          Padding="0,10,0,12">
                <ItemsControl ItemsSource="{Binding FilteredMyGames}" Margin="-8,0,48,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LocalGameCardVm">
                            <Button Classes="xl-card" Classes.focused="{Binding IsFocused}"
                                    Command="{Binding $parent[UserControl].DataContext.OpenMyGameDetailCommand}"
                                    CommandParameter="{Binding}">
                                <Grid ToolTip.Tip="{Binding EffectiveTitle}">
                                    <views:CoverImage ImageUrl="{Binding CoverUrl}"
                                                      FallbackText="{Binding EffectiveTitle}"
                                                      FallbackGradient="{Binding CoverGradient}"
                                                      SubText="{Binding Platform}"
                                                      LetterFontSize="40"
                                                      ImageCornerRadius="0"/>
                                    <Border Classes="xl-badge"
                                            IsVisible="{Binding KindLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding KindLabel}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="24" Margin="0,8,0,14">
                <TextBlock Text="Ⓐ Game info" FontSize="14" Foreground="#b0b0b0"/>
                <TextBlock Text="Ⓑ Back" FontSize="14" Foreground="#b0b0b0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
