<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             xmlns:views="using:GameLauncher.Views"
             x:Class="GameLauncher.Views.GamesLib.XbOneGamesLib"
             x:DataType="vm:LibraryViewModel"
             Background="#101010">

    <!--
        XBOne.Games.Lib - Xbox One library: dark left rail (search + sections with counts), "Games" heading
        and a dense grid of rounded square tiles with platform badges.
        Edit this file to change the "XBOne" Games theme.
    -->
    <UserControl.Styles>
        <Style Selector="Button.xl-card">
            <Setter Property="Width" Value="206"/>
            <Setter Property="Height" Value="206"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.xl-card /template/ ContentPresenter">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3"/>
        </Style>
        <Style Selector="Button.xl-card.focused">
            <Setter Property="ZIndex" Value="5"/>
        </Style>
        <Style Selector="Button.xl-card:pointerover /template/ ContentPresenter, Button.xl-card.focused /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="White"/>
        </Style>
        <Style Selector="Button.xl-nav">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.xl-nav /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.xl-nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2C2C2C"/>
        </Style>
        <Style Selector="Button.xl-nav.filter-chip-active">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.xl-nav.filter-chip-active /template/ ContentPresenter">
            <Setter Property="Background" Value="#107CFF"/>
        </Style>
        <Style Selector="ListBox.xl-plat">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBox.xl-plat ListBoxItem">
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Foreground" Value="#9A9A9A"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="ListBox.xl-plat ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2C2C2C"/>
        </Style>
        <Style Selector="ListBox.xl-plat ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#2F3F5C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="300,*">
        <!-- Left rail -->
        <Border Background="#1B1B1B">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14" Margin="20,26,20,14">
                    <Border Width="44" Height="44" CornerRadius="22" Background="#107CFF">
                        <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Library" FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBox Grid.Row="1" Name="LibrarySearchBox"
                         Classes="form-input"
                         IsTabStop="False"
                         Text="{Binding SearchText}"
                         Watermark="🔍  Search"
                         Margin="20,0,20,16"/>

                <StackPanel Grid.Row="2">
                    <Button Classes="xl-nav" Classes.filter-chip-active="{Binding IsInstallFilterAll}"
                            Command="{Binding SetInstallFilterCommand}" CommandParameter="All">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Games"/>
                            <TextBlock Grid.Column="1" Text="{Binding TotalGames}"/>
                        </Grid>
                    </Button>
                    <Button Classes="xl-nav" Classes.filter-chip-active="{Binding IsInstallFilterInstalled}"
                            Command="{Binding SetInstallFilterCommand}" CommandParameter="Installed">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Installed"/>
                            <TextBlock Grid.Column="1" Text="{Binding InstalledCount}"/>
                        </Grid>
                    </Button>
                    <Button Classes="xl-nav" Classes.filter-chip-active="{Binding IsInstallFilterNotInstalled}"
                            Command="{Binding SetInstallFilterCommand}" CommandParameter="Uninstalled"
                            Content="Not installed"/>
                    <TextBlock Text="PLATFORM" FontSize="11" Foreground="#707070" Margin="18,18,0,4"/>
                </StackPanel>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <ListBox Classes="xl-plat" ItemsSource="{Binding Platforms}" SelectedItem="{Binding FilterPlatform}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <StackPanel Grid.Row="4" Margin="20,10,20,20" IsVisible="{Binding HasFocusedGame}" Spacing="4">
                    <TextBlock Text="{Binding FocusedGame.EffectiveTitle}" FontSize="15" Foreground="White" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding FocusedGame.Platform}" FontSize="12" Foreground="#8A8A8A"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="34,26,0,0">
            <TextBlock Text="Games" FontSize="30" FontWeight="SemiBold" Foreground="White" Margin="8,0,0,16"/>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          Padding="0,0,20,24">
                <ItemsControl ItemsSource="{Binding FilteredMyGames}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LocalGameCardVm">
                            <Button Classes="xl-card"
                                    Classes.focused="{Binding IsFocused}"
                                    Command="{Binding $parent[UserControl].DataContext.OpenMyGameDetailCommand}"
                                    CommandParameter="{Binding}">
                                <Panel>
                                    <views:CoverImage
                                        ImageUrl="{Binding CoverUrl}"
                                        FallbackText="{Binding EffectiveTitle}"
                                        FallbackGradient="{Binding CoverGradient}"
                                        LetterFontSize="64"
                                        ImageCornerRadius="0"/>
                                    <Border VerticalAlignment="Bottom" Background="#CC000000" Padding="10,5">
                                        <TextBlock Text="{Binding Platform}" FontSize="12" Foreground="White"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </Panel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
