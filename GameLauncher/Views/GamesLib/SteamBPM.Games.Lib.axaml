<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             xmlns:views="using:GameLauncher.Views"
             x:Class="GameLauncher.Views.GamesLib.SteamGamesLib"
             x:DataType="vm:LibraryViewModel"
             Background="#2A3040">

    <!--
        SteamBPM.Games.Lib - Steam Big Picture library: black top bar with search, centred pill tabs,
        large portrait covers with soft shadows and a black bottom bar.
        Edit this file to change the "SteamBPM" Games theme.
    -->
    <UserControl.Styles>
        <Style Selector="Button.st-lib-card">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="300"/>
            <Setter Property="Margin" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.st-lib-card /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A1F2B"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="BoxShadow" Value="0 8 22 0 #66000000"/>
        </Style>
        <Style Selector="Button.st-lib-card.focused">
            <Setter Property="ZIndex" Value="5"/>
        </Style>
        <Style Selector="Button.st-lib-card:pointerover /template/ ContentPresenter, Button.st-lib-card.focused /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="White"/>
        </Style>
        <Style Selector="Button.st-pill">
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9AA3B5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.st-pill /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="18"/>
        </Style>
        <Style Selector="Button.st-pill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A4256"/>
        </Style>
        <Style Selector="Button.st-pill.filter-chip-active">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.st-pill.filter-chip-active /template/ ContentPresenter">
            <Setter Property="Background" Value="#4A5266"/>
        </Style>
        <Style Selector="ListBox.st-plat">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBox.st-plat ListBoxItem">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Foreground" Value="#8791A5"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="ListBox.st-plat ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#4A5266"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Top bar -->
        <Border Grid.Row="0" Background="Black" Padding="28,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBox Name="LibrarySearchBox"
                         Classes="form-input"
                         IsTabStop="False"
                         Text="{Binding SearchText}"
                         Watermark="🔍  Search for games or profiles…"
                         Width="320"/>
                <TextBlock Grid.Column="2" Text="{Binding TotalGames, StringFormat='{}{0} games'}"
                           FontSize="14" Foreground="#9AA3B5" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Pill tabs + platforms -->
        <StackPanel Grid.Row="1" Margin="0,22,0,6" Spacing="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Classes="st-pill" Classes.filter-chip-active="{Binding IsInstallFilterAll}"
                        Command="{Binding SetInstallFilterCommand}" CommandParameter="All">
                    <TextBlock Text="{Binding TotalGames, StringFormat='ALL GAMES  {0}'}"/>
                </Button>
                <Button Classes="st-pill" Classes.filter-chip-active="{Binding IsInstallFilterInstalled}"
                        Command="{Binding SetInstallFilterCommand}" CommandParameter="Installed">
                    <TextBlock Text="{Binding InstalledCount, StringFormat='INSTALLED  {0}'}"/>
                </Button>
                <Button Classes="st-pill" Classes.filter-chip-active="{Binding IsInstallFilterNotInstalled}"
                        Command="{Binding SetInstallFilterCommand}" CommandParameter="Uninstalled"
                        Content="NOT INSTALLED"/>
            </StackPanel>
            <ScrollViewer HorizontalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <ListBox Classes="st-plat" ItemsSource="{Binding Platforms}" SelectedItem="{Binding FilterPlatform}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}"/></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </StackPanel>

        <!-- Cover grid -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      Padding="40,10,40,20">
            <ItemsControl ItemsSource="{Binding FilteredMyGames}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LocalGameCardVm">
                        <Button Classes="st-lib-card"
                                Classes.focused="{Binding IsFocused}"
                                Command="{Binding $parent[UserControl].DataContext.OpenMyGameDetailCommand}"
                                CommandParameter="{Binding}">
                            <views:CoverImage
                                ImageUrl="{Binding CoverUrl}"
                                FallbackText="{Binding EffectiveTitle}"
                                FallbackGradient="{Binding CoverGradient}"
                                LetterFontSize="64"
                                ImageCornerRadius="0"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Bottom bar -->
        <Border Grid.Row="3" Background="Black" Padding="28,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="☰  MENU" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding FocusedGame.EffectiveTitle}" IsVisible="{Binding HasFocusedGame}"
                           HorizontalAlignment="Center" FontSize="14" Foreground="#C6CCD8" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="20">
                    <TextBlock Text="Ⓐ  SELECT" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Ⓑ  BACK" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
