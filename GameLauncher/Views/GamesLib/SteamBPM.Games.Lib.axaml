<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             xmlns:views="using:GameLauncher.Views"
             x:Class="GameLauncher.Views.GamesLib.SteamGamesLib"
             x:DataType="vm:LibraryViewModel"
             Background="#0E141B">

    <!--
        SteamBPM.Games.Lib - Modern Steam Big Picture / Steam Deck Library Layout
        Preserves all LibraryViewModel bindings, commands, and element names.
    -->
    <UserControl.Styles>
        <!-- Game Cover Cards -->
        <Style Selector="Button.st-lib-card">
            <Setter Property="Width" Value="172"/>
            <Setter Property="Height" Value="248"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#161D26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.st-lib-card /template/ ContentPresenter">
            <Setter Property="Background" Value="#161D26"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2.5"/>
        </Style>
        <Style Selector="Button.st-lib-card:pointerover, Button.st-lib-card.focused">
            <Setter Property="RenderTransform" Value="scale(1.04)"/>
            <Setter Property="ZIndex" Value="5"/>
        </Style>
        <Style Selector="Button.st-lib-card:pointerover /template/ ContentPresenter, Button.st-lib-card.focused /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
        </Style>

        <!-- Horizontal Pill Filter Tabs (ALL GAMES, INSTALLED, etc.) -->
        <Style Selector="Button.st-lib-tab">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B929A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.st-lib-tab /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>
        <Style Selector="Button.st-lib-tab:pointerover">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.st-lib-tab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1E252E"/>
        </Style>
        <Style Selector="Button.st-lib-tab.filter-chip-active">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.st-lib-tab.filter-chip-active /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A323D"/>
        </Style>

        <!-- LB / RB Bumper Pills -->
        <Style Selector="Border.bumper-pill">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="9,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Top Search Bar -->
        <Style Selector="TextBox.st-deck-search">
            <Setter Property="Background" Value="#181F28"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBox.st-deck-search:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#222B38"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Platform Dropdown -->
        <Style Selector="ComboBox.st-deck-combo">
            <Setter Property="Background" Value="#181F28"/>
            <Setter Property="Foreground" Value="#C6D4DF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Kind Badge on Card -->
        <Style Selector="Border.st-lib-badge">
            <Setter Property="Background" Value="#CC171D25"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Row 0: Top Steam Deck Header Bar (Search + Library Count) -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="32,14,32,8">
            <TextBox Grid.Column="0"
                     Name="LibrarySearchBox"
                     Classes="form-input st-deck-search"
                     IsTabStop="False"
                     Text="{Binding SearchText}"
                     Watermark="🔍   Search for games or profiles..."
                     Width="360"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="MY LIBRARY"
                           FontSize="12"
                           FontWeight="Bold"
                           LetterSpacing="1"
                           Foreground="#8B929A"
                           VerticalAlignment="Center"/>
                <Border Background="#1D2530" CornerRadius="4" Padding="10,4">
                    <TextBlock Text="{Binding TotalGames, StringFormat='{}{0} GAMES'}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Row 1: Horizontal Tab Strip (LB [ ALL GAMES | INSTALLED | NOT INSTALLED ] Platform RB) -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="32,4,32,10">
            <!-- Left Bumper -->
            <Border Grid.Column="0" Classes="bumper-pill">
                <TextBlock Text="LB" FontSize="10" FontWeight="Black" Foreground="#0E141B"/>
            </Border>

            <!-- Center Filter Pills + Platform Selector -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">

                <Button Classes="st-lib-tab"
                        Classes.filter-chip-active="{Binding IsInstallFilterAll}"
                        Command="{Binding SetInstallFilterCommand}"
                        CommandParameter="All">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="ALL GAMES" FontSize="12" FontWeight="Bold" LetterSpacing="0.5"/>
                        <TextBlock Text="{Binding TotalGames}" FontSize="12" Foreground="#6C747E" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Button Classes="st-lib-tab"
                        Classes.filter-chip-active="{Binding IsInstallFilterInstalled}"
                        Command="{Binding SetInstallFilterCommand}"
                        CommandParameter="Installed">
                    <TextBlock Text="INSTALLED" FontSize="12" FontWeight="Bold" LetterSpacing="0.5"/>
                </Button>

                <Button Classes="st-lib-tab"
                        Classes.filter-chip-active="{Binding IsInstallFilterNotInstalled}"
                        Command="{Binding SetInstallFilterCommand}"
                        CommandParameter="Uninstalled">
                    <TextBlock Text="NOT INSTALLED" FontSize="12" FontWeight="Bold" LetterSpacing="0.5"/>
                </Button>

                <!-- Subtle Divider -->
                <Border Width="1" Height="16" Background="#262E38" Margin="6,0"/>

                <!-- Platform Filter -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="PLATFORM" FontSize="11" FontWeight="Bold" Foreground="#6C747E" VerticalAlignment="Center"/>
                    <ComboBox Classes="st-deck-combo"
                              ItemsSource="{Binding Platforms}"
                              SelectedItem="{Binding FilterPlatform}"
                              MinWidth="130"/>
                </StackPanel>
            </StackPanel>

            <!-- Right Bumper -->
            <Border Grid.Column="2" Classes="bumper-pill">
                <TextBlock Text="RB" FontSize="10" FontWeight="Black" Foreground="#0E141B"/>
            </Border>
        </Grid>

        <!-- Row 2: Full-Width Portrait Cover Grid -->
        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Padding="22,4,22,16">
            <ItemsControl ItemsSource="{Binding FilteredMyGames}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LocalGameCardVm">
                        <Button Classes="st-lib-card"
                                Classes.focused="{Binding IsFocused}"
                                Command="{Binding $parent[UserControl].DataContext.OpenMyGameDetailCommand}"
                                CommandParameter="{Binding}">
                            <Grid ToolTip.Tip="{Binding EffectiveTitle}">
                                <views:CoverImage ImageUrl="{Binding CoverUrl}"
                                                  FallbackText="{Binding EffectiveTitle}"
                                                  FallbackGradient="{Binding CoverGradient}"
                                                  SubText="{Binding Platform}"
                                                  LetterFontSize="42"
                                                  ImageCornerRadius="0"/>
                                <Border Classes="st-lib-badge"
                                        IsVisible="{Binding KindLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{Binding KindLabel}" FontSize="10" FontWeight="Bold" Foreground="#E5E9F0"/>
                                </Border>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Row 3: Steam Deck Bottom Footer Bar -->
        <Border Grid.Row="3" Background="#161C24" BorderBrush="#222A35" BorderThickness="0,1,0,0" Padding="32,9">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: Menu Button -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="10" Background="#FFFFFF">
                        <TextBlock Text="✕" FontSize="11" FontWeight="Black" Foreground="#0E141B"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="MENU" FontSize="11" FontWeight="Bold" LetterSpacing="0.5"
                               Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: Highlighted Game Title & Playtime -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FocusedGame.EffectiveTitle}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding FocusedGame.PlaytimeLabel}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#57CB5A"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Controller Prompts (A Select / B Back) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <!-- A Button -->
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="10" Background="#57CB5A">
                            <TextBlock Text="A" FontSize="11" FontWeight="Black" Foreground="#0E141B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="GAME INFO" FontSize="11" FontWeight="Bold" LetterSpacing="0.5"
                                   Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- B Button -->
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="10" Background="#E04F4F">
                            <TextBlock Text="B" FontSize="11" FontWeight="Black" Foreground="#0E141B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="BACK" FontSize="11" FontWeight="Bold" LetterSpacing="0.5"
                                   Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
