<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             xmlns:views="using:GameLauncher.Views"
             x:Class="GameLauncher.Views.GamesLib.Ps5GamesLib"
             x:DataType="vm:LibraryViewModel"
             Background="#0D0D0D">

    <!--
        PS5.Games.Lib — PlayStation 5 style Games (library) page.
        Edit this file to change the "PS5" Games theme; Default.Games.Lib.axaml holds the default one.
        The tile highlighted by the D-pad (IsFocused) is lifted and ringed in white.
    -->
    <UserControl.Styles>
        <Style Selector="Button.ps5-lib-card">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="200"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.ps5-lib-card /template/ ContentPresenter">
            <Setter Property="Background" Value="#161616"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3"/>
        </Style>
        <Style Selector="Button.ps5-lib-card.focused">
            <Setter Property="ZIndex" Value="5"/>
        </Style>
        <Style Selector="Button.ps5-lib-card:pointerover /template/ ContentPresenter, Button.ps5-lib-card.focused /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="#D9D9E6"/>
            <Setter Property="BoxShadow" Value="0 0 24 2 #55FFFFFF"/>
        </Style>
        <!-- Caption (platform + title) is only shown on the highlighted tile, like the console -->
        <Style Selector="Border.ps5-lib-caption">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Button.ps5-lib-card:pointerover Border.ps5-lib-caption, Button.ps5-lib-card.focused Border.ps5-lib-caption">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="Button.ps5-lib-tab">
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Margin" Value="0,0,40,0"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Foreground" Value="#6E6E78"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.ps5-lib-tab /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.ps5-lib-tab:pointerover">
            <Setter Property="Foreground" Value="#D9D9E6"/>
        </Style>
        <Style Selector="Button.ps5-lib-tab.filter-chip-active">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="ListBox.ps5-plat">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBox.ps5-plat ListBoxItem">
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="#8A8A94"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="ListBox.ps5-plat ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#222226"/>
        </Style>
        <Style Selector="ListBox.ps5-plat ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#F2F2F7"/>
            <Setter Property="Foreground" Value="#0D0D0D"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- Dark backdrop with the highlighted game's art softly bleeding through -->
        <Panel IsVisible="{Binding HasFocusedGame}" IsHitTestVisible="False">
            <views:CoverImage ImageUrl="{Binding FocusedGame.CoverUrl}" Opacity="0.22">
                <views:CoverImage.Effect><BlurEffect Radius="70"/></views:CoverImage.Effect>
            </views:CoverImage>
            <Border Background="#AA0D0D0D"/>
        </Panel>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="48,34,48,0">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <Border Width="64" Height="64" CornerRadius="12" Background="#1B1B1F">
                <TextBlock Text="▦" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Grid.Column="1" Text="Game Library" FontSize="30" FontWeight="Light" Foreground="White"
                       VerticalAlignment="Center" Margin="28,0,0,0"/>
            <TextBox Grid.Column="2"
                     Name="LibrarySearchBox"
                     Classes="form-input"
                     IsTabStop="False"
                     Text="{Binding SearchText}"
                     Watermark="🔍  Search games…"
                     Width="240" VerticalAlignment="Center"/>
        </Grid>

        <!-- Tabs -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="92,26,0,8">
            <Button Classes="ps5-lib-tab" Classes.filter-chip-active="{Binding IsInstallFilterAll}"
                    Command="{Binding SetInstallFilterCommand}" CommandParameter="All" Content="All"/>
            <Button Classes="ps5-lib-tab" Classes.filter-chip-active="{Binding IsInstallFilterInstalled}"
                    Command="{Binding SetInstallFilterCommand}" CommandParameter="Installed" Content="Installed"/>
            <Button Classes="ps5-lib-tab" Classes.filter-chip-active="{Binding IsInstallFilterNotInstalled}"
                    Command="{Binding SetInstallFilterCommand}" CommandParameter="Uninstalled" Content="Not installed"/>
            <TextBlock Text="{Binding TotalGames, StringFormat='{}{0} games'}" FontSize="14" Foreground="#6E6E78"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Platforms -->
        <ScrollViewer Grid.Row="2" Margin="84,0,0,12" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
            <ListBox Classes="ps5-plat" ItemsSource="{Binding Platforms}" SelectedItem="{Binding FilterPlatform}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}"/></DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

        <!-- Tile grid -->
        <ScrollViewer Grid.Row="3"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Padding="84,6,0,28">
            <ItemsControl ItemsSource="{Binding FilteredMyGames}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LocalGameCardVm">
                        <Button Classes="ps5-lib-card"
                                Classes.focused="{Binding IsFocused}"
                                Command="{Binding $parent[UserControl].DataContext.OpenMyGameDetailCommand}"
                                CommandParameter="{Binding}">
                            <Panel>
                                <views:CoverImage
                                    ImageUrl="{Binding CoverUrl}"
                                    FallbackText="{Binding EffectiveTitle}"
                                    FallbackGradient="{Binding CoverGradient}"
                                    LetterFontSize="64"
                                    ImageCornerRadius="0"/>
                                <Border Classes="ps5-lib-caption" VerticalAlignment="Bottom" Padding="14,28,14,12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                            <GradientStop Color="#00000000" Offset="0"/>
                                            <GradientStop Color="#EE000000" Offset="0.55"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel Spacing="5">
                                        <Border BorderBrush="#DDFFFFFF" BorderThickness="1" Padding="7,1" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Platform}" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <TextBlock Text="{Binding EffectiveTitle}" FontSize="14" Foreground="White"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </Panel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
    </Grid>
</UserControl>
