<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             xmlns:views="using:GameLauncher.Views"
             x:Class="GameLauncher.Views.GamesLib.Ps6GamesLib"
             x:DataType="vm:LibraryViewModel"
             Background="#030319">

    <!--
        PS6.Games.Lib — PlayStation 6 style Games (library) page.
        Edit this file to change the "PS6" Games theme; Default.Games.Lib.axaml holds the default one.
        The tile highlighted by the D-pad (IsFocused) is lifted and ringed in white.
    -->
    <UserControl.Styles>
        <Style Selector="Button.ps6-lib-card">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="Margin" Value="10,10,14,18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ps6-lib-card /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.ps6-lib-card:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#141A30"/>
        </Style>
        <Style Selector="Button.ps6-lib-card.focused">
            <Setter Property="RenderTransform" Value="scale(1.07)"/>
            <Setter Property="ZIndex" Value="5"/>
        </Style>
        <Style Selector="Button.ps6-lib-card.focused /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="#9BE7FF"/>
            <Setter Property="Background" Value="#1E2646"/>
        </Style>
        <Style Selector="Border.ps6-orb-large">
            <Setter Property="Background">
                <Setter.Value>
                    <RadialGradientBrush>
                        <GradientStop Color="#B5799BFF" Offset="0"/>
                        <GradientStop Color="#665775E8" Offset="0.42"/>
                        <GradientStop Color="#002F3BCC" Offset="1"/>
                    </RadialGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BoxShadow" Value="0 0 90 18 #665D6BFF"/>
        </Style>
        <Style Selector="Button.ps6-lib-card.focused Border.ps6-lib-cover">
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="BoxShadow" Value="0 0 24 4 #D0FFFFFF"/>
        </Style>
        <Style Selector="Button.ps6-lib-chip">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Foreground" Value="#B3B3B3"/>
            <Setter Property="Background" Value="#141A30"/>
        </Style>
        <Style Selector="Button.ps6-lib-chip.filter-chip-active">
            <Setter Property="Foreground" Value="#070A14"/>
            <Setter Property="Background" Value="#CFD9FF"/>
        </Style>
        <Style Selector="Button.ps6-lib-chip.filter-chip-active /template/ ContentPresenter">
            <Setter Property="Background" Value="#CFD9FF"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*" Margin="32,24,32,0">
        <Border Grid.RowSpan="3" Width="560" Height="560" CornerRadius="280"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Classes="ps6-orb-large"/>

        <!-- Header + search -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Library" FontSize="30" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock Text="{Binding TotalGames, StringFormat='   {0} in your collection'}"
                           FontSize="13" Foreground="#9E9E9E" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
            </StackPanel>
            <TextBox Grid.Column="1"
                     Name="LibrarySearchBox"
                     Classes="form-input"
                     IsTabStop="False"
                     Text="{Binding SearchText}"
                     Watermark="🔍  Search games…"
                     Width="240" VerticalAlignment="Center"/>
        </Grid>

        <!-- Platform dropdown + install-status chips -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,10">
            <ComboBox ItemsSource="{Binding Platforms}"
                      SelectedItem="{Binding FilterPlatform}"
                      MinWidth="180"
                      VerticalAlignment="Center"/>
            <Button Classes="ps6-lib-chip"
                    Classes.filter-chip-active="{Binding IsInstallFilterAll}"
                    Command="{Binding SetInstallFilterCommand}"
                    CommandParameter="All">
                <TextBlock Text="All" FontSize="12" FontWeight="SemiBold"/>
            </Button>
            <Button Classes="ps6-lib-chip"
                    Classes.filter-chip-active="{Binding IsInstallFilterInstalled}"
                    Command="{Binding SetInstallFilterCommand}"
                    CommandParameter="Installed">
                <TextBlock Text="Installed" FontSize="12" FontWeight="SemiBold"/>
            </Button>
            <Button Classes="ps6-lib-chip"
                    Classes.filter-chip-active="{Binding IsInstallFilterNotInstalled}"
                    Command="{Binding SetInstallFilterCommand}"
                    CommandParameter="Uninstalled">
                <TextBlock Text="Not installed" FontSize="12" FontWeight="SemiBold"/>
            </Button>
        </StackPanel>

        <!-- Tile grid -->
        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0,0,0,28">
            <ItemsControl ItemsSource="{Binding FilteredMyGames}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LocalGameCardVm">
                        <Button Classes="ps6-lib-card"
                                Classes.focused="{Binding IsFocused}"
                                Command="{Binding $parent[UserControl].DataContext.OpenMyGameDetailCommand}"
                                CommandParameter="{Binding}">
                            <StackPanel>
                                <Border Height="180" CornerRadius="22" ClipToBounds="True"
                                        Classes="ps6-lib-cover">
                                    <views:CoverImage
                                        ImageUrl="{Binding CoverUrl}"
                                        FallbackText="{Binding EffectiveTitle}"
                                        FallbackGradient="{Binding CoverGradient}"
                                        SubText="{Binding Platform}"
                                        LetterFontSize="56"
                                        ImageCornerRadius="22"
                                        Height="180"/>
                                </Border>
                                <TextBlock Text="{Binding EffectiveTitle}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#ECECEC"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="6,8,6,0"/>
                                <TextBlock Text="{Binding Platform}"
                                           FontSize="11" Foreground="#9E9E9E"
                                           Margin="6,2,6,8"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</UserControl>
