<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             xmlns:views="using:GameLauncher.Views"
             x:Class="GameLauncher.Views.MediaLib.VlcMusic"
             x:DataType="vm:MediaViewModel">

    <!-- VLC-style Music: dark playlist window with an orange accent, library tree and the classic bottom control bar. -->
    <UserControl.Styles>
        <Style Selector="Button.vlc-ctl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#e8e8e8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.vlc-ctl:pointerover"><Setter Property="Foreground" Value="#ff8800"/></Style>
        <Style Selector="Button.vlc-ctl:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
        <Style Selector="Button.vlc-play">
            <Setter Property="Background" Value="#ff8800"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.vlc-play:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#ffa733"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.vlc-node">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#d8d8d8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.vlc-node:pointerover /template/ ContentPresenter, Button.vlc-node.focused /template/ ContentPresenter">
            <Setter Property="Background" Value="#ff8800"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.vlc-node.on"><Setter Property="Foreground" Value="#ff8800"/></Style>
        <Style Selector="Button.vlc-row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.vlc-row:pointerover /template/ ContentPresenter, Button.vlc-row.focused /template/ ContentPresenter">
            <Setter Property="Background" Value="#ff8800"/>
        </Style>
        <Style Selector="Button.vlc-row:pointerover TextBlock, Button.vlc-row.focused TextBlock"><Setter Property="Foreground" Value="White"/></Style>
        <Style Selector="ProgressBar.vlc-progress">
            <Setter Property="Foreground" Value="#ff8800"/>
            <Setter Property="Background" Value="#4a4a4a"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="#1e1e1e">

        <!-- Menu strip -->
        <Border Grid.Row="0" Background="#2b2b2b" Padding="12,7">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="🔶" FontSize="18"/>
                    <TextBlock Text="Playlist" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MusicContentTitle}" Foreground="#9a9a9a" FontSize="13" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                </StackPanel>
                <Button Grid.Column="2" Classes="vlc-ctl media-nav" Classes.focused="{Binding IsMusicSearchFocused}"
                        Command="{Binding OpenMusicSearchCommand}" FontSize="13">
                    <TextBlock Text="{Binding MusicSearchLabel}" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="230,*">
            <!-- Library tree -->
            <Border Background="#252525" BorderBrush="#111111" BorderThickness="0,0,1,0" Padding="6,8">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Spacing="1" Margin="0,0,0,8">
                        <TextBlock Text="MEDIA LIBRARY" Foreground="#8a8a8a" FontSize="10" FontWeight="Bold" Margin="10,0,0,4"/>
                        <Button Classes="vlc-node media-nav" Classes.on="{Binding IsMusicArtistsMode}"
                                Classes.focused="{Binding IsMusicTabArtistsFocused}"
                                Command="{Binding SelectMusicTabCommand}" CommandParameter="artists">🎤  Artists</Button>
                        <Button Classes="vlc-node media-nav" Classes.on="{Binding IsMusicPlaylistMode}"
                                Classes.focused="{Binding IsMusicTabPlaylistsFocused}"
                                Command="{Binding SelectMusicTabCommand}" CommandParameter="playlists">📜  Playlists</Button>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MusicEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MediaViewModel+MusicEntry">
                                    <Button Classes="vlc-node media-nav" Classes.focused="{Binding IsFocused}" Padding="26,5,10,5"
                                            Command="{Binding $parent[UserControl].DataContext.SelectMusicEntryByClickCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="2" Classes="vlc-node" Command="{Binding RefreshMediaLibraryCommand}" Margin="0,6,0,0">⟳  Rescan Drives</Button>
                </Grid>
            </Border>

            <!-- Playlist table -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <Border Background="#333333" Padding="10,6" BorderBrush="#111111" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="Title" Foreground="#bdbdbd" FontSize="12" FontWeight="SemiBold" Margin="48,0,0,0"/>
                        <TextBlock Grid.Column="1" Text="Info" Foreground="#bdbdbd" FontSize="12" FontWeight="SemiBold"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Spacing="8" Margin="0,50" HorizontalAlignment="Center" IsVisible="{Binding HasNoMusicRows}">
                    <TextBlock Text="🔶" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="Playlist is empty" Foreground="White" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Add songs to a Music folder on any drive (Artist/Album/Song), then rescan."
                               Foreground="#9a9a9a" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding !HasNoMusicRows}">
                    <ItemsControl ItemsSource="{Binding MusicRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MediaViewModel+MusicRow">
                                <Button Classes="vlc-row media-nav" Classes.focused="{Binding IsFocused}"
                                        Command="{Binding $parent[UserControl].DataContext.PlayMusicRowCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12">
                                        <Border Width="36" Height="36" ClipToBounds="True">
                                            <views:CoverImage FallbackText="{Binding Title}"
                                                              FallbackGradient="{Binding Gradient}" LocalCachePath="{Binding CoverPath}"
                                                              LetterFontSize="16" ImageCornerRadius="2" Width="36" Height="36"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Foreground="#e8e8e8" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="#8a8a8a" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="#bdbdbd" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Classic control bar -->
        <Border Grid.Row="2" Background="#2b2b2b" BorderBrush="#111111" BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <TextBlock Text="{Binding PositionLabel}" Foreground="#bdbdbd" FontSize="11" VerticalAlignment="Center"/>
                    <ProgressBar Grid.Column="1" Classes="vlc-progress" Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent}" Height="5"/>
                    <TextBlock Grid.Column="2" Text="{Binding DurationLabel}" Foreground="#bdbdbd" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto,*">
                    <TextBlock Text="{Binding NowPlayingTitle}" Foreground="White" FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="300" HorizontalAlignment="Left"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button Classes="vlc-ctl" Command="{Binding ToggleShuffleCommand}" Content="🔀" ToolTip.Tip="Random"/>
                        <Button Classes="vlc-ctl" Command="{Binding PreviousTrackCommand}" Content="⏮"/>
                        <Button Classes="vlc-play" Command="{Binding TogglePlayPauseCommand}" Content="{Binding PlayPauseGlyph}"/>
                        <Button Classes="vlc-ctl" Command="{Binding StopMusicCommand}" Content="⏹"/>
                        <Button Classes="vlc-ctl" Command="{Binding NextTrackCommand}" Content="⏭"/>
                        <Button Classes="vlc-ctl" Command="{Binding ToggleRepeatCommand}" Content="🔁" ToolTip.Tip="Loop"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="🔊" Foreground="#bdbdbd" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding VolumeLabel}" Foreground="#bdbdbd" FontSize="11" VerticalAlignment="Center"/>
                        <Button Classes="vlc-ctl" Command="{Binding OpenNowPlayingFullScreenCommand}" Content="⛶" ToolTip.Tip="Full screen (Y)"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
