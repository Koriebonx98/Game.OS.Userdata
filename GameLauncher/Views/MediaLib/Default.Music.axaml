<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             xmlns:views="using:GameLauncher.Views"
             xmlns:local="using:GameLauncher.Views.MediaLib"
             x:Class="GameLauncher.Views.MediaLib.DefaultMusic"
             x:DataType="vm:MediaViewModel">

    <!-- Default Music: console-styled browser (folders left, songs right) with a player panel at the bottom. -->
    <UserControl.Styles>
        <Style Selector="Button.track-row">
            <Setter Property="Background" Value="#161b22"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.track-row:pointerover /template/ ContentPresenter, Button.track-row:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="#21262d"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">
        <local:MusicBrowser Grid.Row="0"/>

        <!-- Player -->
        <Border Grid.Row="1" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid ColumnDefinitions="260,*,Auto" ColumnSpacing="24">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding NowPlayingTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding NowPlayingGroup}" FontSize="11" Foreground="#8b949e"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                        <Button Classes="btn-secondary" Command="{Binding PreviousTrackCommand}" Content="⏮"/>
                        <Button Classes="btn-primary" MinWidth="64" HorizontalContentAlignment="Center"
                                Command="{Binding TogglePlayPauseCommand}"
                                Content="{Binding PlayPauseGlyph}"/>
                        <Button Classes="btn-secondary" Command="{Binding NextTrackCommand}" Content="⏭"/>
                        <Button Classes="btn-secondary" Command="{Binding StopMusicCommand}" Content="⏹"/>
                        <Button Classes="btn-secondary" Command="{Binding ToggleShuffleCommand}" Content="🔀" ToolTip.Tip="Shuffle"/>
                        <Button Classes="btn-secondary" Command="{Binding OpenNowPlayingFullScreenCommand}" Content="⛶" ToolTip.Tip="Full screen (Y)"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <TextBlock Text="{Binding PositionLabel}" FontSize="11" Foreground="#8b949e" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="6"/>
                        <TextBlock Grid.Column="2" Text="{Binding DurationLabel}" FontSize="11" Foreground="#8b949e" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
