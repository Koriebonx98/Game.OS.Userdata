<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             xmlns:views="using:GameLauncher.Views"
             xmlns:models="using:GameLauncher.Models"
             x:Class="GameLauncher.Views.DashboardLib.Ps6Dashboard"
             x:DataType="vm:DashboardViewModel">

    <Border Classes="dashboard-ps6-layout"
            Height="{Binding $parent[ScrollViewer].Bounds.Height}" ClipToBounds="True">
        <Panel>
        <!-- Backdrop: deep navy gradient, optionally the highlighted game's cover (blurred + darkened) -->
        <Border Classes="ps6-backdrop"/>
        <Panel IsVisible="{Binding Ps6BackdropUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               IsHitTestVisible="False">
            <views:CoverImage ImageUrl="{Binding Ps6BackdropUrl}" Opacity="0.45">
                <views:CoverImage.Effect><BlurEffect Radius="48"/></views:CoverImage.Effect>
            </views:CoverImage>
            <Border Background="#99030319"/>
        </Panel>
        <Viewbox Stretch="Uniform">
        <Grid RowDefinitions="Auto,*,Auto" Width="1280" Height="720">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="56,24,56,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="36" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="12" Background="#F4F5FF">
                        <TextBlock Text="☺" Foreground="#17143D" FontSize="26" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Games" Classes="ps6-header-title" VerticalAlignment="Center"/>
                    <TextBlock Text="Media" Classes="ps6-header-media" VerticalAlignment="Center"
                               IsVisible="{Binding Options.ShowMedia}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <Button Classes="ps6-header-icon" Classes.focused="{Binding Ps6HeaderSearchFocused}"
                            Command="{Binding NavigateToAllGamesCommand}" ToolTip.Tip="Search games">⌕</Button>
                    <Button Classes="ps6-header-icon" Classes.focused="{Binding Ps6HeaderSettingsFocused}"
                            Command="{Binding Ps6OpenSettingsCommand}" ToolTip.Tip="Settings">⚙</Button>
                    <TextBlock Text="{Binding SteamClockTime}" Foreground="#F3F2FF" FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="Auto,*">
                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled" Padding="24,34,24,34">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Classes="ps6-carousel-card" Classes.focused="{Binding IsStoreFocused}" Tag="store"
                                Command="{Binding OpenFeaturedDetailCommand}">
                            <Border Classes="ps6-carousel-cover ps6-store-cover">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                    <TextBlock Text="▣" FontSize="72" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="STORE" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>
                        <ItemsControl ItemsSource="{Binding Ps5RecentGames}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LocalGameCardVm">
                                    <Button Classes="ps6-carousel-card" Classes.focused="{Binding IsFocused}"
                                            Command="{Binding $parent[UserControl].DataContext.OpenLocalGameDetailCommand}"
                                            CommandParameter="{Binding}">
                                        <Border Classes="ps6-carousel-cover">
                                            <views:CoverImage ImageUrl="{Binding CoverUrl}"
                                                              FallbackText="{Binding EffectiveTitle}"
                                                              FallbackGradient="{Binding CoverGradient}"
                                                              SubText="{Binding Platform}"
                                                              LetterFontSize="56"
                                                              ImageCornerRadius="4"
                                                              Height="250"/>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="ps6-carousel-card" Classes.focused="{Binding IsAllGamesFocused}" Tag="all"
                                Command="{Binding NavigateToAllGamesCommand}">
                            <Border Classes="ps6-carousel-cover ps6-store-cover">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                    <TextBlock Text="▦" FontSize="64" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="LIBRARY" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Highlighted game: details, achievements and related games -->
                <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="64,0,64,0">
                    <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Top">
                        <TextBlock Text="{Binding FocusedCardTitle}" IsVisible="{Binding HasFocusedCard}"
                                   Classes="ps6-focused-title" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasFocusedCard}">
                            <Border Classes="ps6-platform-badge" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding FocusedCardPlatform}" Foreground="#EAE8FF"
                                           FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="{Binding FocusedCardPlaytime}" Foreground="#D7D4F5" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StoreBriefGame.Title}" IsVisible="{Binding IsStoreFocused}"
                                   Classes="ps6-focused-title" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Play something unforgettable." IsVisible="{Binding IsStoreFocused}"
                                   Foreground="#D7D4F5" FontSize="14"/>
                        <TextBlock Text="Browse your collection" IsVisible="{Binding IsAllGamesFocused}"
                                   Classes="ps6-focused-title"/>

                        <StackPanel IsVisible="{Binding Options.ShowAchievements}">
                        <Button Classes="ps6-ach-mini" HorizontalAlignment="Left" Margin="0,8,0,0" MaxWidth="470"
                                IsVisible="{Binding !IsStoreFocused}"
                                Command="{Binding ToggleAchievementListCommand}"
                                ToolTip.Tip="Show full list">
                        <Border Classes="ps6-achievements-panel" Padding="16,10">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding FocusedCardTrophyHeader}" Foreground="#E6E6F8" FontSize="12"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FocusedCardAchPercentLabel}" Foreground="#9BE7FF"
                                               FontSize="12" FontWeight="SemiBold" Margin="12,0,0,0"
                                               IsVisible="{Binding Options.ShowAchPercent}"/>
                                </Grid>
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding FocusedCardAchPercent}" Height="6"
                                             Foreground="#9BE7FF" Background="#26305F" Margin="0,0,0,6"
                                             IsVisible="{Binding Options.ShowAchBar}"/>
                                <TextBlock Text="{Binding Options.AchievementsWordLower, StringFormat='No {0} yet'}"
                                           Foreground="#9E9EC0" FontSize="12"
                                           IsVisible="{Binding !HasFocusedCardAchievements}"/>
                                <ItemsControl ItemsSource="{Binding FocusedCardAchievements}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:Achievement">
                                            <Grid Margin="0,2" ColumnDefinitions="24,*" Opacity="{Binding LockedOpacity}">
                                                <Border Width="16" Height="16" CornerRadius="8" Background="#9BE7FF"
                                                        VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="★" Foreground="#030319" FontSize="10"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#F2F2FF" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" Margin="6,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Click or press Y for the full list" Foreground="#7F82B5" FontSize="10" Margin="0,6,0,0"
                                           IsVisible="{Binding HasFocusedCardAchievements}"/>
                            </StackPanel>
                        </Border>
                        </Button>
                        </StackPanel>

                        <!-- Captures of the highlighted game -->
                        <StackPanel Spacing="4" Margin="0,10,0,0"
                                    IsVisible="{Binding Options.ShowCaptures}">
                            <StackPanel IsVisible="{Binding HasFocusedCardCaptures}" Spacing="4">
                                <TextBlock Text="Captures" Foreground="#E6E6F8" FontSize="12" FontWeight="SemiBold"/>
                                <ItemsControl ItemsSource="{Binding FocusedCardCaptures}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Width="112" Height="64" CornerRadius="8" ClipToBounds="True"
                                                    BorderBrush="#3A4272" BorderThickness="1">
                                                <views:CoverImage LocalCachePath="{Binding}" ImageCornerRadius="8" Height="64"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top" IsVisible="{Binding HasPs5Shelf}">
                        <TextBlock Text="{Binding Ps5ShelfTitle}" Foreground="#ECECFF" FontSize="14" FontWeight="SemiBold"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Ps5Shelf}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DashboardViewModel+ShelfCardVm">
                                        <Button Classes="ps6-shelf-card"
                                                Command="{Binding $parent[UserControl].DataContext.OpenShelfGameCommand}"
                                                CommandParameter="{Binding}">
                                            <Border Width="90" Height="120" ClipToBounds="True" CornerRadius="6">
                                              <Panel>
                                                <views:CoverImage ImageUrl="{Binding Game.CoverUrl}"
                                                                  FallbackText="{Binding Game.Title}"
                                                                  FallbackGradient="{Binding Game.CoverGradient}"
                                                                  SubText="{Binding Game.Platform}"
                                                                  LetterFontSize="28"
                                                                  ImageCornerRadius="6"
                                                                  Height="120"/>
                                                <Border Background="#E61F2A5A" IsVisible="{Binding IsAll}">
                                                    <TextBlock Text="ALL ›" Foreground="White" FontWeight="Bold" FontSize="16"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                              </Panel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,24">
                <TextBlock Text="{Binding Ps6DockLabel}" Classes="ps6-dock-label"/>
                <Border Classes="ps6-dock">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="ps6-dock-button" Classes.active="{Binding Ps6DockHomeSelected}" Command="{Binding Ps6DockHomeCommand}" ToolTip.Tip="Home">⌂</Button>
                        <Button Classes="ps6-dock-button" Classes.active="{Binding Ps6DockLibrarySelected}" Command="{Binding Ps6DockLibraryCommand}" ToolTip.Tip="Library">▤</Button>
                        <Button Classes="ps6-dock-button" Classes.active="{Binding Ps6DockInboxSelected}" Command="{Binding Ps6DockInboxCommand}" ToolTip.Tip="Notifications">♢</Button>
                        <Button Classes="ps6-dock-button" Classes.active="{Binding Ps6DockFriendsSelected}" Command="{Binding Ps6DockFriendsCommand}" ToolTip.Tip="Friends">♟</Button>
                        <Button Classes="ps6-dock-button" Classes.active="{Binding Ps6DockMusicSelected}" Command="{Binding Ps6DockMusicCommand}" ToolTip.Tip="Music">♫</Button>
                        <Button Classes="ps6-dock-button" Classes.active="{Binding Ps6DockDownloadsSelected}" Command="{Binding Ps6DockDownloadsCommand}" ToolTip.Tip="Downloads">⇩</Button>
                        <Button Classes="ps6-dock-button" Classes.active="{Binding Ps6DockProfileSelected}" Command="{Binding Ps6DockProfileCommand}" ToolTip.Tip="Profile">◉</Button>
                        <Button Classes="ps6-dock-button" Classes.active="{Binding Ps6DockSettingsSelected}" Command="{Binding Ps6DockSettingsCommand}" ToolTip.Tip="Settings">⚙</Button>
                        <Button Classes="ps6-dock-button" Classes.active="{Binding Ps6DockPowerSelected}" Command="{Binding Ps6DockPowerCommand}" ToolTip.Tip="Power">⏻</Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        </Viewbox>
        <!-- Full achievement list (click the mini panel / Y) -->
        <Border IsVisible="{Binding ShowAchievementList}" Background="#CC030319">
            <Border Width="560" MaxHeight="560" Padding="20" CornerRadius="20" Background="#E60B0E22"
                    BorderBrush="#556B72C8" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <TextBlock Text="{Binding AchievementListTitle}" Foreground="White" FontSize="18" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding FocusedCardAchPercent}" Height="6"
                                 Foreground="#9BE7FF" Background="#26305F" Margin="0,8,0,10"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FocusedCardAllAchievements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Achievement">
                                    <Grid Margin="0,4" ColumnDefinitions="30,*" Opacity="{Binding LockedOpacity}">
                                        <TextBlock Text="{Binding StatusIcon}" FontSize="18" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" Foreground="#F2F2FF" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" Foreground="#B8B5D9" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="3" Content="Close  (○ / Y)" Command="{Binding CloseAchievementListCommand}"
                            HorizontalAlignment="Right" Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </Border>
        </Panel>
    </Border>
</UserControl>
