<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             xmlns:models="using:GameLauncher.Models"
             xmlns:views="using:GameLauncher.Views"
             x:Class="GameLauncher.Views.DashboardLib.SteamBpmDashboard"
             x:DataType="vm:DashboardViewModel">

    <Border Classes="dashboard-steambpm-layout" IsVisible="False">
        <Grid RowDefinitions="Auto,Auto,*">
            <Grid Grid.Row="0" Margin="54,24,54,0" ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                <TextBlock Text="Recent Games"
                           IsVisible="{Binding Options.ShowTitle}"
                           Classes="steam-shell-title"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="⌕"
                           Classes="steam-shell-icon"
                           Margin="0,0,18,0"/>
                <TextBlock Grid.Column="2"
                           Text="◉"
                           Classes="steam-shell-icon"
                           Margin="0,0,24,0"/>
                <TextBlock Grid.Column="3"
                           Text="{Binding SteamClockTime}"
                           IsVisible="{Binding Options.ShowClock}"
                           Classes="steam-shell-time"
                           Margin="0,0,22,0"
                           VerticalAlignment="Center"/>
                <Border Grid.Column="4"
                        IsVisible="{Binding Options.ShowProfile}"
                        Classes="steam-shell-avatar"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding SteamProfileInitial}"
                               Classes="steam-shell-avatar-text"/>
                </Border>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="54,22,54,0"
                  Height="392"
                  ColumnDefinitions="2.55*,3.45*"
                  ColumnSpacing="18">
                <Button Grid.Column="0"
                        Classes="steam-hero-recent-button"
                        Command="{Binding ContinuePlayingCommand}">
                    <Grid>
                        <views:CoverImage
                            ImageUrl="{Binding FeaturedGame.CoverUrl}"
                            FallbackText="{Binding FeaturedGame.Title}"
                            FallbackGradient="{Binding FeaturedGame.CoverGradient}"
                            SubText="{Binding FeaturedGame.Platform}"
                            LetterFontSize="110"
                            ImageCornerRadius="0"/>
                        <Border Classes="steam-hero-image-tint"/>
                        <Border VerticalAlignment="Bottom"
                                Classes="steam-hero-info-panel">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding FeaturedGame.Title}"
                                           Classes="steam-hero-game-title"/>
                                <TextBlock Text="{Binding SteamHeroMetaText}"
                                           Classes="steam-hero-game-meta"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Button>

                <ItemsControl Grid.Column="1"
                              ItemsSource="{Binding SteamRecentSideGames}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="18"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LocalGameCardVm">
                            <Button Classes="steam-side-recent-button"
                                    Command="{Binding $parent[UserControl].DataContext.OpenLocalGameDetailCommand}"
                                    CommandParameter="{Binding}">
                                <Grid>
                                    <views:CoverImage
                                        ImageUrl="{Binding CoverUrl}"
                                        FallbackText="{Binding EffectiveTitle}"
                                        FallbackGradient="{Binding CoverGradient}"
                                        SubText="{Binding Platform}"
                                        LetterFontSize="42"
                                        ImageCornerRadius="0"/>
                                    <Border Classes="steam-side-image-tint"/>
                                    <Border VerticalAlignment="Top"
                                            HorizontalAlignment="Left"
                                            Classes="steam-side-card-chip"
                                            IsVisible="{Binding KindLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding KindLabel}"
                                                   Classes="steam-side-card-chip-text"/>
                                    </Border>
                                    <Border VerticalAlignment="Bottom"
                                            Classes="steam-side-card-footer">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding EffectiveTitle}"
                                                       Classes="steam-side-card-title"/>
                                            <TextBlock Text="{Binding PlaytimeLabel}"
                                                       Classes="steam-side-card-meta"
                                                       IsVisible="{Binding PlaytimeLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,18,0,0" Spacing="24">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="18">
                    <Border Classes="steam-tab-pill steam-tab-pill-active">
                        <TextBlock Text="WHAT'S NEW" Classes="steam-tab-pill-text"/>
                    </Border>
                    <Border Classes="steam-tab-pill">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="FRIENDS" Classes="steam-tab-pill-text"/>
                            <Border Classes="steam-tab-count-pill">
                                <TextBlock Text="{Binding OnlineFriendsCount}" Classes="steam-tab-count-text"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Classes="steam-tab-pill">
                        <TextBlock Text="RECOMMENDED" Classes="steam-tab-pill-text"/>
                    </Border>
                </StackPanel>

                <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SteamNewsTiles}"
                                  Margin="54,0,24,28">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="18"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SteamDashboardNewsTileVm">
                                <Border Classes="steam-news-card">
                                    <Grid RowDefinitions="210,Auto">
                                        <Grid Grid.Row="0">
                                            <views:CoverImage
                                                ImageUrl="{Binding CoverUrl}"
                                                FallbackText="{Binding Title}"
                                                FallbackGradient="{Binding CoverGradient}"
                                                SubText="{Binding Category}"
                                                LetterFontSize="58"
                                                ImageCornerRadius="0"/>
                                            <Border Classes="steam-news-image-tint"/>
                                        </Grid>
                                        <Border Grid.Row="1" Classes="steam-news-footer">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{Binding Category}"
                                                           Classes="steam-news-category"/>
                                                <TextBlock Text="{Binding Title}"
                                                           TextWrapping="Wrap"
                                                           Classes="steam-news-title"/>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           TextWrapping="Wrap"
                                                           Classes="steam-news-subtitle"/>
                                                <TextBlock Text="{Binding Meta}"
                                                           Classes="steam-news-meta"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
