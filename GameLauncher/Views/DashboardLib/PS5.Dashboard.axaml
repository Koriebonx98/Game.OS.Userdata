<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             xmlns:models="using:GameLauncher.Models"
             xmlns:views="using:GameLauncher.Views"
             x:Class="GameLauncher.Views.DashboardLib.Ps5Dashboard"
             x:DataType="vm:DashboardViewModel">

    <Border Classes="dashboard-ps5-layout"
            Height="{Binding $parent[ScrollViewer].Bounds.Height}">
        <Grid RowDefinitions="Auto,180,*,Auto">

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="28,18,28,12" IsVisible="{Binding Options.ShowHeader}">
                <TextBlock Text="Games" Classes="ps5-header-title"/>
                <TextBlock Text="  Media" Classes="ps5-header-media" IsVisible="{Binding Options.ShowMedia}"/>
            </StackPanel>

            <!-- Horizontal card row -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Padding="20,0">
                <StackPanel Orientation="Horizontal">
                    <!-- Store card -->
                    <Button Classes="game-card-btn ps5-game-card-btn" Tag="store"
                            Classes.focused="{Binding IsStoreFocused}"
                            Command="{Binding OpenFeaturedDetailCommand}">
                        <StackPanel>
                            <Border Height="120" ClipToBounds="True" CornerRadius="10" Background="#1F1F1F">
                                <TextBlock Text="Store" Foreground="#ECECEC" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Store" Classes="ps5-card-title" Margin="8,6,8,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Games -->
                    <ItemsControl ItemsSource="{Binding Ps5RecentGames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LocalGameCardVm">
                                <Button Classes="game-card-btn ps5-game-card-btn"
                                        Classes.focused="{Binding IsFocused}"
                                        Command="{Binding $parent[UserControl].DataContext.OpenLocalGameDetailCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <Border Height="120" ClipToBounds="True" CornerRadius="10">
                                            <views:CoverImage
                                                ImageUrl="{Binding CoverUrl}"
                                                FallbackText="{Binding EffectiveTitle}"
                                                FallbackGradient="{Binding CoverGradient}"
                                                SubText="{Binding Platform}"
                                                LetterFontSize="38"
                                                ImageCornerRadius="10"
                                                Height="120"/>
                                        </Border>
                                        <TextBlock Text="{Binding EffectiveTitle}"
                                                   Classes="ps5-card-title"
                                                   Margin="8,6,8,0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- All games card -->
                    <Button Classes="game-card-btn ps5-game-card-btn" Tag="all"
                            Classes.focused="{Binding IsAllGamesFocused}"
                            Command="{Binding NavigateToAllGamesCommand}">
                        <StackPanel>
                            <Border Height="120" ClipToBounds="True" CornerRadius="10" Background="#1F1F1F">
                                <TextBlock Text="All Games" Foreground="#ECECEC" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="All Games" Classes="ps5-card-title" Margin="8,6,8,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Content under the strip: store brief / trophies of the highlighted game, then a shelf of play cards -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
            <!-- Store brief (Store tile highlighted) -->
            <StackPanel Margin="40,14,40,0" Spacing="6" IsVisible="{Binding IsStoreFocused}">
                <TextBlock Text="Store" Foreground="#00AEEF" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StoreBriefGame.Title}" Foreground="White" FontSize="30" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding StoreBriefGame.Genre}" Foreground="#B3B3B3" FontSize="14"/>
                    <TextBlock Text="{Binding StoreBriefGame.Platform}" Foreground="#B3B3B3" FontSize="14"/>
                    <TextBlock Text="{Binding StoreBriefGame.Price}" Foreground="#00AEEF" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="{Binding StoreBriefGame.Description}" Foreground="#B3B3B3" FontSize="15"
                           TextWrapping="Wrap" MaxLines="3" MaxWidth="760" HorizontalAlignment="Left"/>
            </StackPanel>

            <!-- Trophies of the highlighted game (live as focus moves) -->
            <StackPanel IsVisible="{Binding Options.ShowAchievements}">
            <Border HorizontalAlignment="Left" Margin="28,14,0,0"
                    Padding="16,12" Classes="ps5-achievements-panel"
                    IsVisible="{Binding !IsStoreFocused}">
                <StackPanel Width="420">
                    <TextBlock Text="{Binding FocusedCardTrophyHeader}" Foreground="#E6E6E6" FontSize="13"
                               FontWeight="SemiBold" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"/>
                    <Rectangle Height="1" Fill="#2B2B2B" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Options.AchievementsWordLower, StringFormat='No {0} yet'}" Foreground="#9E9E9E" FontSize="12"
                               IsVisible="{Binding !HasFocusedCardAchievements}"/>
                    <ItemsControl ItemsSource="{Binding FocusedCardAchievements}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Achievement">
                                <Grid Margin="0,3" ColumnDefinitions="28,*" Opacity="{Binding LockedOpacity}">
                                    <Border Width="20" Height="20" CornerRadius="10" Background="#FFD400"
                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="T" Foreground="Black" FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Name}" Foreground="#F2F2F2" FontSize="13"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding StatusLabel}" Foreground="#9E9E9E" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- Shelf: recommended games (Store tile) or games related to the highlighted game -->
            <StackPanel Margin="28,16,0,8" Spacing="8" IsVisible="{Binding HasPs5Shelf}">
                <TextBlock Text="{Binding Ps5ShelfTitle}" Foreground="#ECECEC" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Ps5Shelf}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DashboardViewModel+ShelfCardVm">
                                <Button Classes="game-card-btn ps5-game-card-btn"
                                        Classes.focused="{Binding IsFocused}"
                                        Command="{Binding $parent[UserControl].DataContext.OpenShelfGameCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <Border Height="100" ClipToBounds="True" CornerRadius="10">
                                            <views:CoverImage
                                                ImageUrl="{Binding Game.CoverUrl}"
                                                FallbackText="{Binding Game.Title}"
                                                FallbackGradient="{Binding Game.CoverGradient}"
                                                SubText="{Binding Game.Platform}"
                                                LetterFontSize="32"
                                                ImageCornerRadius="10"
                                                Height="100"/>
                                        </Border>
                                        <TextBlock Text="{Binding Game.Title}" Classes="ps5-card-title" Margin="8,6,8,0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
            </StackPanel>
            </ScrollViewer>

            <!-- Bottom status tiles -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="20,0,0,56">
                <Border Classes="ps5-status-tile" Width="120" Height="52" Padding="10"
                        IsVisible="{Binding Options.ShowAchievements}">
                    <StackPanel>
                        <TextBlock Text="{Binding AchievementsCount}" Classes="ps5-status-value"/>
                        <TextBlock Text="{Binding Options.AchievementsWord}" Classes="ps5-status-label"/>
                    </StackPanel>
                </Border>
                <Border Classes="ps5-status-tile" Width="160" Height="52" Padding="10" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding OnlineFriendsCount}" Classes="ps5-status-value"/>
                        <TextBlock Text="Friends Online" Classes="ps5-status-label"/>
                    </StackPanel>
                </Border>
                <Border Classes="ps5-status-tile" Width="140" Height="52" Padding="10" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TotalPlaytimeLabel}" Classes="ps5-status-value"/>
                    </StackPanel>
                </Border>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
