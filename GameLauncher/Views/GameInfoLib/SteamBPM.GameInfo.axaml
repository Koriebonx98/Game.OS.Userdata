<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             xmlns:views="using:GameLauncher.Views"
             xmlns:models="using:GameLauncher.Models"
             x:Class="GameLauncher.Views.GameInfoLib.SteamGameInfo"
             x:DataType="vm:GameDetailViewModel">

    <!--
        SteamBPM.GameInfo - Steam Big Picture "game info" page: artwork banner, big green Play button,
        a stats strip (play time, platform, genre, year, achievements) and the same install / drive options as
        the other themes. "···" and the cloud button open the inline action menu
        (Views/GameInfoLib/GameInfo.ActionMenu.axaml), which works with a controller.
        Edit this file to change the "SteamBPM" Game Info theme.
    -->
    <UserControl.Styles>
        <Style Selector="Button.btn-primary, Button.btn-success, Button.btn-secondary">
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="Button.btn-primary /template/ ContentPresenter, Button.btn-success /template/ ContentPresenter, Button.btn-secondary /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="Button.btn-primary /template/ ContentPresenter, Button.btn-success /template/ ContentPresenter">
            <Setter Property="Background" Value="#5BA32B"/>
        </Style>
        <Style Selector="Button.btn-secondary /template/ ContentPresenter">
            <Setter Property="Background" Value="#3D4E5C"/>
        </Style>
        <Style Selector="Button:focus /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="3"/>
        </Style>
        <Style Selector="TextBlock.st-stat-label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#8BA3B8"/>
        </Style>
        <Style Selector="TextBlock.st-stat-value">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>

    <Border Background="#16202D" ClipToBounds="True">
        <Panel>
            <!-- Artwork banner behind the info -->
            <Panel Opacity="0.28" IsHitTestVisible="False">
                <views:CoverImage ImageUrl="{Binding CoverUrl}"
                                  FallbackText=""
                                  FallbackGradient="{Binding CoverGradient}"
                                  ImageCornerRadius="0"/>
            </Panel>
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#F016202D" Offset="0"/>
                        <GradientStop Color="#9916202D" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid ColumnDefinitions="240,*" Margin="28,24">
                <Border Grid.Column="0" ClipToBounds="True" CornerRadius="3"
                        Width="220" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <views:CoverImage ImageUrl="{Binding CoverUrl}"
                                      FallbackText="{Binding Title}"
                                      FallbackGradient="{Binding CoverGradient}"
                                      SubText="{Binding Genre}"
                                      LetterFontSize="80"
                                      ImageCornerRadius="3"
                                      Width="220" Height="300"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="12" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Title}" FontSize="36" FontWeight="Bold"
                               Foreground="White" TextWrapping="Wrap"/>

                    <!-- Stats strip -->
                    <StackPanel Orientation="Horizontal" Spacing="34" Margin="0,2,0,2">
                        <StackPanel Spacing="2" IsVisible="{Binding HasPlaytime}">
                            <TextBlock Text="PLAY TIME" Classes="st-stat-label"/>
                            <TextBlock Text="{Binding PlaytimeLabel}" Classes="st-stat-value" Foreground="#4BAD4E"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="PLATFORM" Classes="st-stat-label"/>
                            <TextBlock Text="{Binding Platform}" Classes="st-stat-value"/>
                        </StackPanel>
                        <StackPanel Spacing="2"
                                    IsVisible="{Binding Genre, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="GENRE" Classes="st-stat-label"/>
                            <TextBlock Text="{Binding Genre}" Classes="st-stat-value"/>
                        </StackPanel>
                        <StackPanel Spacing="2"
                                    IsVisible="{Binding ReleaseYear, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="RELEASED" Classes="st-stat-label"/>
                            <TextBlock Text="{Binding ReleaseYear}" Classes="st-stat-value"/>
                        </StackPanel>
                        <StackPanel Spacing="2" IsVisible="{Binding HasRegions}">
                            <TextBlock Text="REGION" Classes="st-stat-label"/>
                            <TextBlock Text="{Binding RegionsLabel}" Classes="st-stat-value"/>
                        </StackPanel>
                        <StackPanel Spacing="2" IsVisible="{Binding HasDisplayTitleId}">
                            <TextBlock Text="ID" Classes="st-stat-label"/>
                            <TextBlock Text="{Binding DisplayTitleId}" Classes="st-stat-value"
                                       FontFamily="Consolas,Menlo,monospace"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding RatingStars}" FontSize="18" Foreground="#C6D4DF"/>

                    <!-- Play row (installed) -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0"
                                IsVisible="{Binding IsInstalled}">
                        <Button Classes="btn-primary"
                                Classes.btn-resume="{Binding PlayButtonIsResume}"
                                Padding="40,14"
                                Command="{Binding LaunchGameCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="▶" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PlayButtonLabel}" FontSize="16" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="btn-secondary" Padding="16,14" ToolTip.Tip="Game Settings"
                                Command="{Binding ToggleMoreMenuCommand}">
                            <TextBlock Text="⚙" FontSize="18" VerticalAlignment="Center"/>
                        </Button>
                        <Button Classes="btn-secondary" Padding="16,14" ToolTip.Tip="Manage Mods"
                                Command="{Binding OpenModsPanelCommand}"
                                IsVisible="{Binding IsSwitch}">
                            <TextBlock Text="🧩  Mods" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Button>
                        <Button Classes="btn-secondary" Padding="16,14" ToolTip.Tip="Backup / Restore saves"
                                Command="{Binding ToggleCloudMenuCommand}">
                            <TextBlock Text="☁" FontSize="18" VerticalAlignment="Center"/>
                        </Button>
                        <Button Classes="btn-secondary" Padding="16,14" ToolTip.Tip="Refresh Achievements"
                                Command="{Binding SyncExophaseNowCommand}"
                                IsEnabled="{Binding !IsExophaseSyncing}"
                                IsVisible="{Binding HasExophaseUrl}">
                            <TextBlock Text="↻" FontSize="16" VerticalAlignment="Center"/>
                        </Button>
                        <Button Classes="btn-secondary" Padding="16,14" ToolTip.Tip="Controller Profiles"
                                Command="{Binding ToggleControllerPanelCommand}">
                            <TextBlock Text="🎮" FontSize="18" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding ExophaseSyncStatus}" FontSize="12" Foreground="#5BB6FF"
                               IsVisible="{Binding ExophaseSyncStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="{Binding LudusaviSyncStatus}" FontSize="12" Foreground="#4BAD4E"
                               IsVisible="{Binding LudusaviSyncStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <TextBlock Text="{Binding Description}" FontSize="14" Foreground="#C6D4DF"
                               TextWrapping="Wrap" MaxWidth="640"
                               IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <!-- Install (repack) -->
                    <StackPanel Spacing="6" IsVisible="{Binding IsRepack}">
                        <Button Classes="btn-success" Padding="30,14" HorizontalAlignment="Left"
                                IsEnabled="{Binding !IsExtracting}"
                                Command="{Binding InstallRepackCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="⬇" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding InstallButtonLabel}" FontSize="15" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding RepackSizeLabel}" FontSize="11" Foreground="#8BA3B8"
                                   IsVisible="{Binding RepackSizeLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <Border IsVisible="{Binding ShowInstallSourcePicker}" Background="#10161E"
                                CornerRadius="4" Padding="16,14">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Choose install source" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="btn-secondary" Padding="16,10"
                                            Command="{Binding ChooseRepackInstallSourceCommand}">Repack/zip</Button>
                                    <Button Classes="btn-secondary" Padding="16,10"
                                            Command="{Binding ChooseSteamInstallSourceCommand}">Steam</Button>
                                    <Button Classes="btn-secondary" Padding="12,10"
                                            Command="{Binding CancelInstallSourceCommand}">Cancel</Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border IsVisible="{Binding IsExtracting}" Background="#10161E" CornerRadius="4" Padding="12,10">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Extracting…" FontSize="12" Foreground="#8BA3B8"/>
                                    <TextBlock Text="{Binding ExtractionProgress, StringFormat='{}{0:F0}%'}"
                                               FontSize="12" Foreground="#5BB6FF" FontWeight="SemiBold"/>
                                </StackPanel>
                                <ProgressBar Value="{Binding ExtractionProgress}" Minimum="0" Maximum="100"
                                             Height="6" CornerRadius="3" Foreground="#1A9FFF" Background="#26384A"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding InstallStatusMessage}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{Binding InstallStatusForeground}"
                                   IsVisible="{Binding InstallStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Install via Steam -->
                    <StackPanel Spacing="6" IsVisible="{Binding ShowStandaloneSteamInstall}">
                        <Button Classes="btn-success" Padding="30,14" HorizontalAlignment="Left"
                                Command="{Binding InstallViaSteamCommand}">
                            <TextBlock Text="⬇  Install" FontSize="16" FontWeight="Bold"/>
                        </Button>
                        <TextBlock Text="Opens the Steam client to download and install this game."
                                   FontSize="11" Foreground="#8BA3B8"/>
                    </StackPanel>

                    <!-- Cloud-only -->
                    <StackPanel Spacing="6" IsVisible="{Binding IsCloudOnly}">
                        <Button Classes="btn-secondary" Padding="30,14" IsEnabled="False" HorizontalAlignment="Left">
                            <TextBlock Text="⬇  Install" FontSize="16" FontWeight="Bold"/>
                        </Button>
                        <TextBlock Text="This game is in your library but not installed on this device."
                                   FontSize="11" Foreground="#8BA3B8"/>
                    </StackPanel>

                    <Border IsVisible="{Binding HasMatchingRepack}" Background="#2d1b00" CornerRadius="3"
                            Padding="12,8" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding MatchingRepackLabel}" FontSize="12" Foreground="#f0a030"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <Button Classes="btn-secondary" Padding="20,10" HorizontalAlignment="Left"
                            IsVisible="{Binding HasStoreUrl}"
                            Command="{Binding OpenStorePageCommand}">
                        <TextBlock Text="{Binding StoreButtonLabel}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#5BB6FF"/>
                    </Button>

                    <!-- Drive picker -->
                    <Border IsVisible="{Binding ShowDrivePicker}" Background="#10161E" CornerRadius="4" Padding="16,14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Choose Install Location" FontSize="14" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Select a drive with a Games folder (or create one):"
                                       FontSize="12" Foreground="#8BA3B8"/>
                            <ItemsControl ItemsSource="{Binding InstallDrives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:InstallDriveOption">
                                        <Button Margin="0,0,0,6" Background="#26384A" BorderThickness="0"
                                                CornerRadius="3" Padding="12,10"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Cursor="Hand"
                                                Command="{Binding $parent[UserControl].DataContext.SelectInstallDriveCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="💿"/>
                                                        <TextBlock Text="{Binding DriveRoot}" FontSize="13"
                                                                   FontWeight="SemiBold" Foreground="White"/>
                                                        <Border CornerRadius="3" Padding="6,2" Background="#4BAD4E"
                                                                IsVisible="{Binding GamesExists}">
                                                            <TextBlock Text="Games ✓" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                                        </Border>
                                                        <Border CornerRadius="3" Padding="6,2" Background="#1A9FFF"
                                                                IsVisible="{Binding !GamesExists}">
                                                            <TextBlock Text="+ Add Games" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding GamesFolderPath}" FontSize="11"
                                                               Foreground="#8BA3B8" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding FreeSpaceLabel}" FontSize="12"
                                                           Foreground="#4BAD4E" VerticalAlignment="Center"
                                                           Margin="12,0,0,0"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="btn-secondary" Padding="12,8" Command="{Binding CancelInstallCommand}">Cancel</Button>
                        </StackPanel>
                    </Border>

                    <!-- Install location -->
                    <Border IsVisible="{Binding IsInstalled}" Background="#10161E" CornerRadius="4"
                            Padding="14,12" HorizontalAlignment="Left">
                        <StackPanel Spacing="4">
                            <TextBlock Text="INSTALLED" Classes="st-stat-label" Foreground="#4BAD4E"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding ActiveDriveLabel}" FontSize="13" Foreground="White"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ActiveExeType}" FontSize="12" Foreground="#4BAD4E"
                                           FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ActiveDrivePath}" FontSize="11" Foreground="#8BA3B8"
                                       TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Panel>
    </Border>
</UserControl>
