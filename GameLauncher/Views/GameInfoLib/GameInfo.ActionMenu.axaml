<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             xmlns:models="using:GameLauncher.Models"
             x:Class="GameLauncher.Views.GameInfoLib.GameInfoActionMenu"
             x:DataType="vm:GameDetailViewModel">

    <!--
        Inline action menu shared by every Game Info theme. Opened by "···" (More) or the ☁ button.
        All entries are normal buttons, so D-pad / A work through the detail page's controller navigation;
        B (back) closes the menu first.
    -->
    <Panel>
    <Border IsVisible="{Binding IsActionMenuOpen}" Background="#CC000000">
    <Border Background="#161b22" BorderBrush="#30363d" BorderThickness="1"
            CornerRadius="16" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="6" MinWidth="360">
            <TextBlock Text="{Binding ActionMenuTitle}" FontSize="16" FontWeight="Bold"
                       Foreground="#8b949e" Margin="8,2,0,4"/>

            <!-- More (···) -->
            <StackPanel Spacing="4" IsVisible="{Binding IsMoreMenu}">
                <Button Classes="btn-secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Command="{Binding MenuOpenSettingsCommand}" Content="⚙  Game Settings"/>
                <Button Classes="btn-secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Command="{Binding MenuLaunchViaSteamCommand}" Content="🎮  Launch via Steam"
                        IsVisible="{Binding HasSteamLaunchOption}"/>
                <Button Classes="btn-secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Command="{Binding MenuOpenControllerCommand}" Content="🎮  Controller Profiles"/>
                <Button Classes="btn-secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Command="{Binding MenuOpenModsCommand}" Content="🧩  Mods"/>
                <Button Classes="btn-secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Command="{Binding MenuOpenBrowserCommand}" Content="🌐  Browser: links, downloads &amp; walkthroughs"/>
                <Button Classes="btn-secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Command="{Binding MenuRefreshAchievementsCommand}" Content="↻  Refresh Achievements"
                        IsVisible="{Binding HasExophaseUrl}"/>
            </StackPanel>

            <!-- Cloud -->
            <StackPanel Spacing="4" IsVisible="{Binding IsCloudMenu}">
                <Button Classes="btn-secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Command="{Binding MenuBackupCommand}" Content="☁  Backup saves"
                        IsEnabled="{Binding !IsLudusaviSyncing}"/>
                <Button Classes="btn-secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Command="{Binding MenuRestoreCommand}" Content="↙  Restore saves"
                        IsEnabled="{Binding !IsLudusaviRestoring}"/>
                <TextBlock Text="Other — choose where this game's save is" FontSize="12" Foreground="#8b949e" Margin="8,8,0,0"/>
                <TextBlock Text="{Binding CustomSavePath}" FontSize="11" Foreground="#58a6ff" Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis" IsVisible="{Binding HasCustomSavePath}"/>
                <Button Classes="btn-secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Command="{Binding MenuChooseSaveFolderCommand}" Content="📁  Other: choose save folder…"/>
                <Button Classes="btn-secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Command="{Binding MenuChooseSaveFileCommand}" Content="📄  Other: choose save file…"/>
                <Button Classes="btn-secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Command="{Binding MenuClearCustomSaveCommand}" Content="✕  Clear custom save location"
                        IsVisible="{Binding HasCustomSavePath}"/>
            </StackPanel>

            <Button Classes="btn-secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Command="{Binding CloseActionMenuCommand}" Content="✕  Close"/>
        </StackPanel>
    </Border>
    </Border>

    <!-- Mod browser: searchable list of the database's mod links, opens in the browser -->
    <Border IsVisible="{Binding IsModBrowserOpen}" Background="#CC000000">
        <Border Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="16" Padding="16"
                Width="560" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="🧩  MODS" FontSize="16" FontWeight="Bold" Foreground="White" Margin="4,0,0,8"/>
                <TextBox DockPanel.Dock="Top" Classes="form-input" Text="{Binding ModSearchText}"
                         Watermark="🔍  Search mods…" Margin="0,0,0,8"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                    <Button Classes="btn-secondary" Command="{Binding OpenRyujinxModsCommand}"
                            Content="Ryujinx mod manager" IsVisible="{Binding IsSwitch}"/>
                    <Button Classes="btn-secondary" Command="{Binding CloseModBrowserCommand}" Content="✕  Close"/>
                </StackPanel>
                <TextBlock Text="No mods listed for this game." Foreground="#8b949e" Margin="4,8"
                           IsVisible="{Binding NoModsFound}"/>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <ItemsControl ItemsSource="{Binding FilteredMods}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:GameModEntry">
                                <StackPanel Margin="0,0,0,6" Spacing="4">
                                    <Button Classes="btn-secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Padding="12,10"
                                            Command="{Binding $parent[UserControl].DataContext.ToggleModDetailCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="🧩" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="White"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <ItemsControl ItemsSource="{Binding Genres}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Border Background="#336c8cff" CornerRadius="10" Padding="8,2" Margin="0,0,4,0">
                                                                <TextBlock Text="{Binding}" FontSize="11" Foreground="#c9d1d9"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding ExpandArrow}" Foreground="#8b949e"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </Grid>
                                    </Button>
                                    <Border IsVisible="{Binding IsExpanded}" Background="#0d1117" BorderBrush="#30363d"
                                            BorderThickness="1" CornerRadius="10" Padding="14,10">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding DisplayDescription}" FontSize="12" Foreground="#c9d1d9" TextWrapping="Wrap"/>
                                            <Button Classes="btn-secondary" HorizontalAlignment="Left" Content="↗  Open in browser"
                                                    Command="{Binding $parent[UserControl].DataContext.OpenModUrlCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Border>
    </Panel>
</UserControl>
