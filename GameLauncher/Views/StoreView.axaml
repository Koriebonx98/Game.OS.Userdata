<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.ViewModels"
             xmlns:store="using:GameLauncher.Views.StoreLib"
             x:Class="GameLauncher.Views.StoreView"
             x:DataType="vm:StoreViewModel"
             Background="#0d1117">

    <!--
        Host for the Store / App Store page. The layout lives in separate, easy-to-edit files
        chosen by Settings → Design → Library:
          Views/StoreLib/Default.Store.axaml   ("Default")
          Views/StoreLib/PS5.Store.axaml       ("PS5")
          Views/StoreLib/Store.Overlays.axaml  (controller filter menu + on-screen keyboard)
    -->
    <Panel>
        <ScrollViewer IsVisible="{Binding IsDefaultStore}">
            <store:DefaultStore Name="DefaultStoreView"/>
        </ScrollViewer>
        <store:Ps5Store Name="Ps5StoreView" IsVisible="{Binding IsPs5Store}"/>
        <store:StoreOverlays/>
    </Panel>
</UserControl>
